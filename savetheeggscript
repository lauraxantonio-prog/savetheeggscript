-- ===== Shader (Lighting-Effekte: Bloom, SunRays, Farbkorrektur, Tiefenunschärfe) =====
PF.sh={cur=0,k=2,objs={},names={{"Aus","Off"},{"Realistisch","Realistic"},{"Cinematic","Cinematic"},{"Lebhaft","Vivid"},{"Sonnenuntergang","Sunset"},{"Hell (Fullbright)","Fullbright"}}}
PF.shK={0.5,1,1.6}
function PF.shClear()
    for _,o in ipairs(PF.sh.objs) do pcall(function() o:Destroy() end) end
    PF.sh.objs={}
    local s=PF.sh.L
    if s then
        for k,v in pairs(s) do pcall(function() Lighting[k]=v end) end
        PF.sh.L=nil
    end
end
function PF.shMk(cls,props)
    local o=Instance.new(cls)
    for k,v in pairs(props) do pcall(function() o[k]=v end) end
    o.Name="AH_Shader"
    o.Parent=Lighting
    PF.sh.objs[#PF.sh.objs+1]=o
    return o
end
function PF.shLight(t)
    local s=PF.sh.L or {}
    PF.sh.L=s
    for k,v in pairs(t) do
        if s[k]==nil then
            local ok,cur=pcall(function() return Lighting[k] end)
            if ok then s[k]=cur end
        end
        pcall(function() Lighting[k]=v end)
    end
end
function PF.setShader(i)
    local sh=PF.sh
    sh.cur=i
    PF.shClear()
    if i~=0 then
        -- Shader und "Grafik minimieren" schließen sich aus
        if PF.gfx then
            PF.setGfx(false)
            if PF.ui.gfx then PF.ui.gfx(false) end
        end
        local k=PF.shK[sh.k]
        local mk=PF.shMk
        local function sr(v) return math.min(1,v*k) end
        if i==1 then        -- Realistisch
            mk("BloomEffect",{Intensity=0.35*k,Size=24,Threshold=1})
            mk("SunRaysEffect",{Intensity=sr(0.12),Spread=0.6})
            mk("ColorCorrectionEffect",{Contrast=0.08*k,Saturation=0.15*k})
            PF.shLight({GlobalShadows=true,EnvironmentSpecularScale=1,EnvironmentDiffuseScale=1})
        elseif i==2 then    -- Cinematic
            mk("BloomEffect",{Intensity=0.5*k,Size=30,Threshold=0.9})
            mk("SunRaysEffect",{Intensity=sr(0.2),Spread=0.7})
            mk("ColorCorrectionEffect",{Contrast=0.2*k,Saturation=-0.1*k,TintColor=Color3.fromRGB(255,240,225)})
            mk("DepthOfFieldEffect",{FarIntensity=math.min(1,0.25*k),FocusDistance=60,InFocusRadius=40,NearIntensity=0})
            PF.shLight({GlobalShadows=true})
        elseif i==3 then    -- Lebhaft
            mk("BloomEffect",{Intensity=0.3*k,Size=20,Threshold=1})
            mk("SunRaysEffect",{Intensity=sr(0.1),Spread=0.5})
            mk("ColorCorrectionEffect",{Contrast=0.15*k,Saturation=0.5*k})
        elseif i==4 then    -- Sonnenuntergang
            mk("BloomEffect",{Intensity=0.5*k,Size=28,Threshold=0.95})
            mk("SunRaysEffect",{Intensity=sr(0.25),Spread=0.8})
            mk("ColorCorrectionEffect",{Contrast=0.1*k,Saturation=0.2*k,TintColor=Color3.fromRGB(255,205,165)})
            PF.shLight({ColorShift_Top=Color3.fromRGB(255,170,100),GlobalShadows=true})
        elseif i==5 then    -- Hell (Fullbright)
            PF.shLight({Brightness=3,Ambient=Color3.new(1,1,1),OutdoorAmbient=Color3.new(1,1,1),FogEnd=1e6,GlobalShadows=false})
        end
    end
    if PF.onShader then pcall(PF.onShader) end
end

function PF.offAll()
    PF.setShader(0)
    PF.setGfx(false) PF.setFx(false) PF.setFps(false) PF.setRender(false)
