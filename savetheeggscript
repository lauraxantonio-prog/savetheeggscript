--// KANDIDATEN-CACHE (Egg ESP)
local cand,exL={}, {}
local function ptext(o) return (o.ObjectText.." "..o.ActionText):lower() end

do
local watched={}
local function consider(o)
    if o.ClassName=="ProximityPrompt" then
        if has(ptext(o),unpack(allKeys)) then cand[o]=true end
        if has(ptext(o),unpack(EXCL)) then exL[o]=true else exL[o]=nil end
    elseif o:IsA("TextLabel") then
        if not watched[o] then
            watched[o]=true
            bind(o:GetPropertyChangedSignal("Text"), function() consider(o) end)
        end
        if has(clean(o.Text),unpack(allKeys)) then cand[o]=true else cand[o]=nil end
        if has(clean(o.Text),unpack(EXCL)) then exL[o]=true else exL[o]=nil end
    elseif o:IsA("PVInstance") then
        if has(o.Name:lower(),unpack(allKeys)) or has(attrText(o),unpack(allKeys)) then
            cand[o]=true
        end
    end
end

bind(workspace.DescendantAdded, consider)
task.spawn(function()
    local d=workspace:GetDescendants()
    for i=1,#d do
        consider(d[i])
        if i%400==0 then RS.Heartbeat:Wait() end
    end
end)

end

local function eggRoot(t)
    if t and t:IsA("Attachment") then t=t.Parent end
    if not (t and t:IsA("PVInstance")) or t==workspace then return nil end
    local r,a=t,t.Parent
    while a and a~=workspace and a:IsA("Model") and not big(a) do r=a a=a.Parent end
    return r
end

local function buildItems(rp)
    local items,seen={}, {}
    local ch=P.Character
    local exRoots={}
    for o in pairs(exL) do
        if not o.Parent then exL[o]=nil
        else
            local ad
            if o.ClassName=="ProximityPrompt" then ad=o.Parent
            else
                local gui=o:FindFirstAncestorWhichIsA("LayerCollector")
                ad=gui and (gui.Adornee or gui.Parent)
            end
            if ad and ad~=workspace then
                local r=eggRoot(ad)
                if r then exRoots[#exRoots+1]=r end
            end
        end
    end

    local function exByText(t)
        for _,r in ipairs(exRoots) do
            if r==t or t:IsDescendantOf(r) or r:IsDescendantOf(t) then return true end
        end
        return false
    end

    for o in pairs(cand) do
        if not o.Parent then cand[o]=nil
        else
            local tgt,kt,nm,viaText
            if o.ClassName=="ProximityPrompt" then
                kt=ptext(o) tgt=eggRoot(o.Parent) nm=o.ObjectText
            elseif o:IsA("TextLabel") then
                kt=clean(o.Text) nm=kt viaText=true
                local gui=o:FindFirstAncestorWhichIsA("LayerCollector")
                local ad=gui and (gui.Adornee or gui.Parent)
                if ad and ad~=workspace and #kt<=40 then tgt=eggRoot(ad) end
            else
                kt=o.Name:lower()..attrText(o) tgt=o nm=o.Name
                local pp=o:FindFirstChildWhichIsA("ProximityPrompt",true)
                if anc(o) or (pp and pp.ObjectText~="") then tgt=nil end
            end

            if tgt and not seen[tgt] and not (ch and tgt:IsDescendantOf(ch)) and not has(kt,unpack(EXCL)) and not has(kt,unpack(EXCL_SELF)) and not has(tgt.Name:lower(),unpack(EXCL_SELF)) and not exAnc(tgt) and not big(tgt) and not exByText(tgt) then
                seen[tgt]=true
                local pos=cfOf(tgt).Position
                items[#items+1]={tgt=tgt,kt=kt,n=nm,pos=pos,d=(pos-rp).Magnitude,ign=skip(tgt),txt=viaText,
                    s=has(kt,"rainbow","regenbogen") and 2 or (has(kt,"retro") and 3 or (has(kt,"gold") and 1 or 0))}
            end
        end
    end
    return items
end

--// SERVER-HOP (gibt {de,en} zurück)
function X.hop()
    local TPS=game:GetService("TeleportService")
    local H=game:GetService("HttpService")
    local function get(u)
        local ok,r=pcall(function() return game:HttpGet(u) end)
        if ok and r then return r end
        local rq=(syn and syn.request) or request or http_request
        return rq({Url=u}).Body
    end
    local url="https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    local c,cursor={},""
    for _=1,3 do
        local ok,res=pcall(function() return H:JSONDecode(get(url..(cursor~="" and "&cursor="..cursor or ""))) end)
        if not ok or not res or not res.data then break end
        for _,s in ipairs(res.data) do
            if s.id~=game.JobId and s.playing<s.maxPlayers then c[#c+1]=s end
        end
        if #c>0 or not res.nextPageCursor then break end
        cursor=res.nextPageCursor
    end
    if #c==0 then return {"Kein anderer Server gefunden","No other server found"} end
    if AUTOLOAD and queue_on_teleport then
        queue_on_teleport('loadstring(game:HttpGet("'..AUTOLOAD..'"))()')
    end
    TPS:TeleportToPlaceInstance(game.PlaceId,c[math.random(1,math.min(#c,15))].id,P)
    return {"Wechsle Server...","Switching server..."}
end

--// SERVER-REJOIN
function X.rejoin()
    local TPS=game:GetService("TeleportService")
    if AUTOLOAD and queue_on_teleport then
        queue_on_teleport('loadstring(game:HttpGet("'..AUTOLOAD..'"))()')
    end
    if #Players:GetPlayers()<=1 then
        TPS:Teleport(game.PlaceId,P)
    else
        TPS:TeleportToPlaceInstance(game.PlaceId,game.JobId,P)
    end
    return {"Verbinde neu...","Rejoining..."}
end

