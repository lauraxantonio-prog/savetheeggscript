-- Segment-Auswahl (gibt Setter zurück)
local function segmented(parent,name,desc,options,idx,cb,bw)
    bw=bw or 36
    local w=#options*(bw+2)+4
    local b=new("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,44)},parent)
    new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,10,0,7),Size=UDim2.new(1,-w-26,0,16),Text=name,TextColor3=C.txt,
        Font=FONT,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left},b)
    new("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,10,0,24),Size=UDim2.new(1,-w-26,0,14),Text=desc,TextColor3=C.sub,
        Font=FONT,TextSize=11,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd},b)
    local box=new("Frame",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-8,0.5,0),Size=UDim2.new(0,w,0,26),BackgroundColor3=C.btn,BorderSizePixel=0},b)
    round(box,6) stroke(box,C.border,1) pad(box,2,2,2,2)
    new("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,2)},box)
    local btns={}
    local sel=idx
    local function paint()
        for i,bt in ipairs(btns) do
            tw(bt,{BackgroundTransparency=(i==sel) and 0 or 1,TextColor3=(i==sel) and Color3.new(1,1,1) or C.sub})
        end
    end
    for i,o in ipairs(options) do
        local bt=new("TextButton",{Size=UDim2.new(0,bw,1,0),BackgroundColor3=C.accent,BackgroundTransparency=1,Text=o,TextColor3=C.sub,
            Font=FONT,TextSize=11,AutoButtonColor=false,LayoutOrder=i},box)
        round(bt,4)
        btns[i]=bt
        bt.MouseEnter:Connect(function() if sel~=i then tw(bt,{TextColor3=C.txt}) end end)
        bt.MouseLeave:Connect(function() if sel~=i then tw(bt,{TextColor3=C.sub}) end end)
        bt.MouseButton1Click:Connect(function()
            sel=i paint()
            local okc,e=pcall(cb,i)
            if not okc then warn(e) end
        end)
    end
    accentHooks[#accentHooks+1]=function()
        for _,bt in ipairs(btns) do bt.BackgroundColor3=C.accent end
        paint()
    end
    paint()
    X.reg(name,function() return sel end,function(i) sel=i paint() pcall(cb,i) end)
    return function(i) sel=i paint() end
end

