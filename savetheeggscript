function X.setOpen(v,done)
    X.anim=X.anim+1
    local id=X.anim
    X.open=v
    if v then
        if not f.Visible then
            f.Visible=true
            uiScale.Scale=0.01
        end
        TS:Create(uiScale,TweenInfo.new(0.32,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),{Scale=X.base}):Play()
    else
        TS:Create(uiScale,TweenInfo.new(0.22,Enum.EasingStyle.Quint,Enum.EasingDirection.In),{Scale=0.01}):Play()
        task.delay(0.24,function()
            if X.anim~=id then return end
            f.Visible=false
            uiScale.Scale=X.base
            if done then done() end
        end)
    end
end

