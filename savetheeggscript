                        ln = Drawing.new("Line") ln.Thickness = 1.5 ln.Visible = false
                        box = Drawing.new("Square") box.Thickness = 1.5 box.Filled = false box.Visible = false
                    end
                    m = {bb = bb, lb = lb, hl = hl, ln = ln, box = box, hrp = hrp, char = char}
                    playerMarks[plr] = m
                end
                local col = PS.col
                local lines = {}
                local nm = PS.nameMode
                if nm == 2 then
                    lines[#lines+1] = plr.Name
                elseif nm == 3 then
                    lines[#lines+1] = plr.DisplayName
                elseif nm == 4 then
                    lines[#lines+1] = (plr.DisplayName == plr.Name) and plr.Name or (plr.DisplayName .. " (@" .. plr.Name .. ")")
                end
                if PS.item then
                    -- nur anzeigen, wenn wirklich ein Item in der Hand ist
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then lines[#lines+1] = "Item: " .. tool.Name end
                end
                if PS.leader then
                    for _, l in ipairs(X.leaderLines(plr)) do lines[#lines+1] = l end
                end
                if PS.dist then lines[#lines+1] = "[" .. math.floor(dist) .. "m]" end
                m.lb.Text = table.concat(lines, "\n")
                m.lb.TextColor3 = col
                m.hl.OutlineColor = col
                m.hl.Enabled = PS.hl
                m.bb.Enabled = true
            else
                killPM(plr)
            end
        end
    end
end

