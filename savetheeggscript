-- Zeichnen der Spieler-ESP-Elemente (pro Frame)
local function drawPlayer(pm,cam,vs)
    local col=PS.col
    local hrp,char=pm.hrp,pm.char
    local alive=hrp and hrp.Parent and char and char.Parent

    -- Tracer (unten / Mitte)
    if pm.ln then
        local show=false
        if PS.tracer and alive then
            local v=cam:WorldToViewportPoint(hrp.Position)
            if v.Z>0 then
                pm.ln.Color=col
                pm.ln.From=Vector2.new(vs.X/2, PS.tracerFrom==1 and vs.Y or vs.Y/2)
                pm.ln.To=Vector2.new(v.X,v.Y)
                show=true
            end
        end
        pm.ln.Visible=show
    end

    -- Box (2D / 3D / Ecken)
    if pm.box then pm.box.Visible=false end
    X.hideAll(pm.box3) X.hideAll(pm.corner)
    if PS.box and alive and Drawing then
        local cf,size=char:GetBoundingBox()
        local pts,front={}, true
        local minX,minY,maxX,maxY=math.huge,math.huge,-math.huge,-math.huge
        for ix=0,1 do for iy=0,1 do for iz=0,1 do
            local v=cam:WorldToViewportPoint(cf:PointToWorldSpace(Vector3.new((ix*2-1)*size.X/2,(iy*2-1)*size.Y/2,(iz*2-1)*size.Z/2)))
            pts[ix*4+iy*2+iz]=v
            if v.Z<=0 then front=false end
            if v.X<minX then minX=v.X end
            if v.X>maxX then maxX=v.X end
            if v.Y<minY then minY=v.Y end
            if v.Y>maxY then maxY=v.Y end
        end end end
        local bt=PS.boxType
        if bt==2 then
            -- 3D-Quader: 12 Kanten
            pm.box3=pm.box3 or X.mkLines(12,1.5)
            local n=0
            for i=0,7 do
                for _,bit in ipairs({1,2,4}) do
                    if i%(bit*2)<bit then
                        n=n+1
                        local a,b=pts[i],pts[i+bit]
                        local l=pm.box3[n]
                        if a.Z>0 and b.Z>0 then
                            l.From=Vector2.new(a.X,a.Y) l.To=Vector2.new(b.X,b.Y) l.Color=col l.Visible=true
                        end
                    end
                end
            end
        elseif front then
            local w,h=maxX-minX,maxY-minY
            if bt==3 then
                -- Eck-Box
                pm.corner=pm.corner or X.mkLines(8,1.5)
                local L=math.min(w,h)*0.3
                local segs={
                    {minX,minY,minX+L,minY},{minX,minY,minX,minY+L},
                    {maxX,minY,maxX-L,minY},{maxX,minY,maxX,minY+L},
                    {minX,maxY,minX+L,maxY},{minX,maxY,minX,maxY-L},
                    {maxX,maxY,maxX-L,maxY},{maxX,maxY,maxX,maxY-L},
                }
                for i,s in ipairs(segs) do
                    local l=pm.corner[i]
                    l.From=Vector2.new(s[1],s[2]) l.To=Vector2.new(s[3],s[4]) l.Color=col l.Visible=true
                end
            elseif pm.box then
                -- 2D-Rahmen
                pm.box.Position=Vector2.new(minX,minY)
                pm.box.Size=Vector2.new(w,h)
                pm.box.Color=col
                pm.box.Visible=true
            end
        end
    end

    -- Skeleton inkl. Kopfkreis (Kopf + Hals)
    if PS.skel and alive and Drawing then
        if not pm.bones then
            pm.bones={}
            for i=1,14 do
                local l=Drawing.new("Line")
                l.Thickness=1.5 l.Visible=false
                pm.bones[i]=l
            end
        end
        if not pm.headC then
            local c=Drawing.new("Circle")
            c.Thickness=1.5 c.NumSides=24 c.Filled=false c.Visible=false
            pm.headC=c
        end
        if pm.skChar~=char or tick()-(pm.skT or 0)>3 then
            pm.skChar=char pm.skT=tick()
            local def=char:FindFirstChild("UpperTorso") and X.BONES15 or X.BONES6
            pm.skPairs={}
            for _,b in ipairs(def) do
                local a,c=char:FindFirstChild(b[1]),char:FindFirstChild(b[2])
                if a and c then pm.skPairs[#pm.skPairs+1]={a,c} end
            end
        end
        for i=1,14 do
            local l=pm.bones[i]
            local pr=pm.skPairs[i]
            local show=false
            if pr and pr[1].Parent and pr[2].Parent then
                local pa=cam:WorldToViewportPoint(pr[1].Position)
                local pc=cam:WorldToViewportPoint(pr[2].Position)
                if pa.Z>0 and pc.Z>0 then
                    l.From=Vector2.new(pa.X,pa.Y)
                    l.To=Vector2.new(pc.X,pc.Y)
                    l.Color=col
                    show=true
                end
            end
            l.Visible=show
        end
        -- Kopfkreis
        local head=char:FindFirstChild("Head")
        local showH=false
        if head and head:IsA("BasePart") then
            local c0=cam:WorldToViewportPoint(head.Position)
            local c1=cam:WorldToViewportPoint(head.Position+Vector3.new(0,head.Size.Y/2,0))
            if c0.Z>0 then
                pm.headC.Position=Vector2.new(c0.X,c0.Y)
                pm.headC.Radius=math.max(2,math.abs(c1.Y-c0.Y))
                pm.headC.Color=col
                showH=true
            end
        end
        pm.headC.Visible=showH
    else
        if pm.bones then for _,l in ipairs(pm.bones) do l.Visible=false end end
        if pm.headC then pm.headC.Visible=false end
    end
end

