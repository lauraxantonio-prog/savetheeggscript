-- Position eines ProximityPrompts (Part oder Attachment)
local function ppPos(p)
    local par = p.Parent
    if par and par:IsA("Attachment") then return par.WorldPosition end
    if par and par:IsA("BasePart") then return par.Position end
    if par and par:IsA("Model") then return par:GetPivot().Position end
    return nil
end

-- Alle Prompts, die zu diesem Ei gehören (max. 15 Studs vom Ei entfernt), nächster zuerst
function F.prompts(t, part)
    local list, seen = {}, {}
    local center = part.Position
    local function add(p)
        if p and p:IsA("ProximityPrompt") and not seen[p] and p.Enabled then
            local pos = ppPos(p)
            if pos and (pos - center).Magnitude <= 15 then
                seen[p] = true
                list[#list+1] = {p = p, d = (pos - center).Magnitude}
            end
        end
    end
    add(t)
    for _, d in ipairs(t:GetDescendants()) do add(d) end
    local par = t.Parent
    if par and par ~= workspace and par:IsA("Model") then
        local n = 0
        for _, d in ipairs(par:GetDescendants()) do
            n = n + 1 if n > 300 then break end
            add(d)
        end
    end
    for o in pairs(cand) do
        if o.Parent and o.ClassName == "ProximityPrompt" then add(o) end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    local out = {}
    for i = 1, math.min(#list, 3) do out[i] = list[i].p end
    return out
end

