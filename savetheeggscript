local function selectTab(key)
    local changed=(current~=key)
    current=key
    for n,p in pairs(pages) do
        local on=(n==key)
        p.Visible=on
        if on and changed then
            p.Position=UDim2.new(0,0,0,14)
            tw(p,{Position=UDim2.new(0,0,0,0)},0.28)
        end
    end
    for n,t in pairs(tabs) do
        local on=(n==key)
        tw(t.btn,{BackgroundTransparency=on and 0 or 1})
        tw(t.bar,{BackgroundTransparency=on and 0 or 1,Size=on and UDim2.new(0,3,0,20) or UDim2.new(0,3,0,14)})
        tw(t.lb,{TextColor3=on and C.txt or C.sub})
