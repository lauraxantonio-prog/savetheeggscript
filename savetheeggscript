    local a=o
    while a and a:IsA("GuiObject") do if not a.Visible then return false end a=a.Parent end
    local sg=o:FindFirstAncestorOfClass("ScreenGui")
    return o.AbsoluteSize.X>5 and (not sg or sg.Enabled)
