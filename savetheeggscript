local function new(cls,props,parent)
    local o=Instance.new(cls)
    for k,v in pairs(props) do
        if k=="Text" and type(v)~="string" then
            reg[#reg+1]={o=o,p=v}
            o.Text=tr(v)
        elseif k=="Font" then
            o.Font=(v==FONTB and X.fcur[2]) or (v==FONT and X.fcur[1]) or v
        else
            o[k]=v
        end
    end
    if props.Font==FONT or props.Font==FONTB then
        X.txt[o]={b=(props.Font==FONTB)}
    end
    -- Farb-Rollen merken (nur während des Aufbaus)
    if not X.built then
        for _,prop in ipairs(X.COLPROPS) do
            local v=props[prop]
            if typeof(v)=="Color3" then
                for _,role in ipairs(X.ROLES) do
                    if C[role]==v then
                        X.rb[o]=X.rb[o] or {}
                        X.rb[o][prop]=role
                        break
                    end
                end
            end
        end
    end
    o.Parent=parent
    return o
end
