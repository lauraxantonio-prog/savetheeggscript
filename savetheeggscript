-- Ei-Namen ermitteln (für die Mutations-Anzeige): Texte/Prompts/Attribute/Namen durchsuchen
X.generic={egg=true,eggs=true,ei=true,eier=true,model=true,part=true,meshpart=true,union=true,handle=true,
    hitbox=true,root=true,primarypart=true,main=true,body=true,base=true,mesh=true,world=true,
    worldegg=true,worldeggs=true,eggmodel=true,folder=true,map=true,default=true,egggui=true}
X.nc=setmetatable({},{__mode="k"})
function X.strip(raw,w,fr)
    local low=raw:lower()
    local pat=fr and ("%f[%a]"..w.."%f[%A]") or nil
    while true do
        local s,e
        if pat then s,e=low:find(pat) else s,e=low:find(w,1,true) end
        if not s then break end
        raw=raw:sub(1,s-1).." "..raw:sub(e+1)
        low=raw:lower()
    end
    return raw
end
function X.clean(raw)
    if type(raw)~="string" then return nil end
    raw=(raw:gsub("<[^>]+>",""))
    raw=raw:gsub("(%l)(%u)","%1 %2")          -- DragonEgg -> Dragon Egg
    raw=raw:gsub("[_%-:|]+"," ")
    for _,w in ipairs(X.words) do raw=X.strip(raw,w) end   -- Mutations-Wörter raus
    raw=X.strip(raw,"world egg") raw=X.strip(raw,"worldegg") raw=X.strip(raw,"world",true)
    raw=raw:gsub("%s+"," ")
    raw=raw:gsub("^%s+",""):gsub("%s+$","")
    if #raw<3 or #raw>32 or not raw:find("%a%a%a") then return nil end
    if raw:find("%d+%s*:%s*%d+") or raw:find("^%[?%d") or raw:find("%d%d") then return nil end
    local l=raw:lower()
    if X.generic[(l:gsub("%s",""))] then return nil end
    if raw==l then raw=raw:gsub("(%a)([%w]*)",function(a,b) return a:upper()..b end) end
    return raw
end
function X.lines(txt)
    if type(txt)~="string" then return nil end
    for ln in txt:gmatch("[^\r\n]+") do
        local r=X.clean(ln)
        if r then return r end
    end
    return nil
end
function X.find(it)
    local t=it.tgt
    local r=X.lines(it.n)
    if r then return r end
    -- Prompts & Labels direkt am Ei
    local n=0
    for _,d in ipairs(t:GetDescendants()) do
        n=n+1 if n>400 then break end
        r=nil
        if d:IsA("ProximityPrompt") then r=X.lines(d.ObjectText)
        elseif d:IsA("TextLabel") or d:IsA("TextButton") then r=X.lines(d.Text) end
        if r then return r end
    end
    -- BillboardGuis im PlayerGui, die am Ei hängen
    local pgui=P:FindFirstChildOfClass("PlayerGui")
    if pgui then
        for _,gui in ipairs(pgui:GetChildren()) do
            if gui:IsA("BillboardGui") and gui.Adornee
                and (gui.Adornee==t or gui.Adornee:IsDescendantOf(t) or t:IsDescendantOf(gui.Adornee)) then
                for _,d in ipairs(gui:GetDescendants()) do
                    if d:IsA("TextLabel") then r=X.lines(d.Text) if r then return r end end
                end
            end
        end
    end
    -- Attribute (Name/Egg/Type/Kind) am Ei und seinen Eltern
    local a=t
    for _=1,3 do
        if not a or a==workspace then break end
        local ok,at=pcall(function() return a:GetAttributes() end)
        if ok and at then
            for k,v in pairs(at) do
                if type(v)=="string" then
                    local kl=tostring(k):lower()
                    if kl:find("name",1,true) or kl:find("egg",1,true) or kl:find("type",1,true) or kl:find("kind",1,true) then
                        r=X.clean(v) if r then return r end
                    end
                end
            end
        end
        a=a.Parent
    end
    -- Objektnamen (WorldEgg & Co. werden ignoriert)
    a=t
    for _=1,3 do
        if not a or a==workspace then break end
        r=X.clean(a.Name) if r then return r end
        a=a.Parent
    end
    return nil
end
function X.base(it)
    local t=it.tgt
    if not t then return nil end
    local c=X.nc[t]
    if c and (c.v or tick()-c.t<8) then return c.v or nil end
    local ok,v=pcall(X.find,it)
    if not ok then v=nil end
    X.nc[t]={v=v or false,t=tick()}
    return v
end
function X.mkLines(n,th)
    local t={}
    for i=1,n do
