local setSizeSeg,setTransSeg

--------------------------------------------------------------------
-- THEME anwenden
--  * X.applyTheme()         -> alles neu einfärben
--  * X.applyTheme("accent") -> nur Akzent-Objekte (schnell, für den Farbwähler)
--------------------------------------------------------------------
function X.applyTheme(only)
    local th=X.THEMES[X.theme.idx] or X.THEMES[1]
    if not only then
        for k,v in pairs(th.c) do C[k]=v end
    end
    C.accent=X.theme.accent or th.c.accent
    C.btxt=C.accent
    for o,map in pairs(X.rb) do
        if o.Parent then
            for prop,role in pairs(map) do
                if not only or role==only then
                    pcall(function() o[prop]=C[role] end)
                end
            end
        end
    end
    for _,h in ipairs(accentHooks) do pcall(h) end
    if current then selectTab(current) end
end
function X.setTheme(i)
    if not X.THEMES[i] then return end
    X.theme.idx=i
    X.theme.accent=nil               -- Theme bringt seine eigene Akzentfarbe mit
    X.applyTheme()
    if X.setAccPick then X.setAccPick(C.accent) end
end
function X.setAccent(col,fromPicker)
    X.theme.accent=col
    X.applyTheme("accent")
    if not fromPicker and X.setAccPick then X.setAccPick(col) end
end

