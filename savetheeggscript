        ColorSequenceKeypoint.new(5/6,rgb(255,0,255)),
        ColorSequenceKeypoint.new(1,rgb(255,0,0)),
    })},hue)
    local hueDot=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Size=UDim2.new(1,6,0,5),BackgroundColor3=Color3.new(1,1,1),
        BorderSizePixel=0,ZIndex=3,Active=false},hue)
    round(hueDot,2) stroke(hueDot,Color3.new(0,0,0),1)

    local function apply(fire)
        local col=Color3.fromHSV(h,s,v)
        sw.BackgroundColor3=col
        sv.BackgroundColor3=Color3.fromHSV(h,1,1)
        svDot.Position=UDim2.new(s,0,1-v,0)
        hueDot.Position=UDim2.new(0.5,0,h,0)
        if fire then
            local okc,e=pcall(cb,col)
            if not okc then warn(e) end
        end
    end
    apply(false)

    local mode
    local function upd()
        local m=UIS:GetMouseLocation()-GS:GetGuiInset()
        if mode=="sv" then
            s=math.clamp((m.X-sv.AbsolutePosition.X)/math.max(sv.AbsoluteSize.X,1),0,1)
            v=1-math.clamp((m.Y-sv.AbsolutePosition.Y)/math.max(sv.AbsoluteSize.Y,1),0,1)
        elseif mode=="hue" then
            h=math.clamp((m.Y-hue.AbsolutePosition.Y)/math.max(hue.AbsoluteSize.Y,1),0,0.999)
        else return end
        apply(true)
    end
    sv.MouseButton1Down:Connect(function() mode="sv" upd() end)
    hue.MouseButton1Down:Connect(function() mode="hue" upd() end)
    bind(UIS.InputChanged,function(i)
        if mode and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd() end
    end)
    bind(UIS.InputEnded,function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then mode=nil end
    end)
    sw.MouseButton1Click:Connect(function() pick.Visible=not pick.Visible end)

    if not noreg then
        X.reg(name,function() return {h,s,v} end,function(t)
            if type(t)=="table" and #t==3 then h,s,v=t[1],t[2],t[3] apply(true) end
        end)
    end
    return function(col)
        h,s,v=Color3.toHSV(col)
        apply(false)
    end
end

