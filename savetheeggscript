local function tr(p)
    if type(p)=="function" then return p() end
    if type(p)=="table" then
        if lang=="de" then return p[1] end
        local en=p[2] or p[1]
        if lang=="en" then return en end
        local d=X.L[lang]
        if not d then return en end
        local hit=d[en]
        if hit then return hit end
        local pre,rest=en:match("^(.-: )(.*)$")     -- z.B. "Fetching egg: Dragon"
        if pre and d[pre] then return d[pre]..rest end
        return en
    end
    return p
end
local function refreshLang()
    for _,e in ipairs(reg) do pcall(function() e.o.Text=tr(e.p) end) end
end

