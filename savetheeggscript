-- ===== Grafik minimieren (Schatten, Effekte, Materialien, Texturen, Himmel/Nebel) =====
function PF.gfxObj(o)
    if o:IsA("Terrain") then return end
    if o:IsA("BasePart") then
        if PF.saved[o]==nil then PF.saved[o]={o.Material,o.Reflectance,o.CastShadow} end
        o.Material=Enum.Material.SmoothPlastic o.Reflectance=0 o.CastShadow=false
    elseif o:IsA("Decal") or o:IsA("Texture") then
        if PF.saved[o]==nil then PF.saved[o]={o.Transparency} end
        o.Transparency=1
    elseif o:IsA("Atmosphere") then
        if PF.saved[o]==nil then PF.saved[o]={o.Density} end
        o.Density=0
    elseif o:IsA("Clouds") or o:IsA("BloomEffect") or o:IsA("BlurEffect") or o:IsA("SunRaysEffect") or o:IsA("DepthOfFieldEffect") then
        if PF.saved[o]==nil then PF.saved[o]={o.Enabled} end
        o.Enabled=false
    end
end
function PF.setGfx(v)
    PF.gfx=v
    PF.gen=PF.gen+1
    local gen=PF.gen
    if v then
        if PF.sh and PF.sh.cur~=0 then PF.setShader(0) end
        if not PF.L then
            PF.L={}
            pcall(function() PF.L.gs=Lighting.GlobalShadows end)
            pcall(function() PF.L.q=settings().Rendering.QualityLevel end)
            pcall(function() PF.L.dec=workspace.Terrain.Decoration end)
        end
        pcall(function() Lighting.GlobalShadows=false end)
        pcall(function() settings().Rendering.QualityLevel=Enum.QualityLevel.Level01 end)
        pcall(function() workspace.Terrain.Decoration=false end)
        task.spawn(function()
            local list=workspace:GetDescendants()
            for i=1,#list do
                if PF.gen~=gen then return end
                pcall(PF.gfxObj,list[i])
                if i%800==0 then task.wait() end
            end
            for _,o in ipairs(Lighting:GetDescendants()) do pcall(PF.gfxObj,o) end
            local cam=workspace.CurrentCamera
            if cam then for _,o in ipairs(cam:GetChildren()) do pcall(PF.gfxObj,o) end end
        end)
    else
        for o,s in pairs(PF.saved) do
            if o.Parent then
                pcall(function()
                    if o:IsA("BasePart") then o.Material,o.Reflectance,o.CastShadow=s[1],s[2],s[3]
                    elseif o:IsA("Decal") or o:IsA("Texture") then o.Transparency=s[1]
                    elseif o:IsA("Atmosphere") then o.Density=s[1]
                    else o.Enabled=s[1] end
                end)
            end
            PF.saved[o]=nil
        end
        if PF.L then
            local L=PF.L
            if L.gs~=nil then pcall(function() Lighting.GlobalShadows=L.gs end) end
            if L.q~=nil then pcall(function() settings().Rendering.QualityLevel=L.q end) end
            if L.dec~=nil then pcall(function() workspace.Terrain.Decoration=L.dec end) end
            PF.L=nil
        end
    end
end

