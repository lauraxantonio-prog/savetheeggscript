function F.grab(it, hrp)
    local t = it.tgt
    local part = t:IsA("BasePart") and t or t:FindFirstChildWhichIsA("BasePart", true)
    if not part then return false end

    local pps = F.prompts(t, part)
    local aim = part.Position
    if pps[1] then aim = ppPos(pps[1]) or aim end

    local cf = CFrame.new(aim + Vector3.new(0, 2, 0))
    tp(hrp, cf)
    local pin = F.pin(hrp, cf)       -- hält dich am Ei fest (ohne Anchor, damit der Server die Position sieht)
    task.wait(F.delay + 0.25)

    if #pps == 0 then pps = F.prompts(t, part) end   -- Prompt wurde evtl. erst jetzt geladen
    for _, pp in ipairs(pps) do
        pcall(function()
            pp.RequiresLineOfSight = false
            pp.MaxActivationDistance = math.max(pp.MaxActivationDistance, 40)
        end)
    end

    local function gone()
        if not (t.Parent and part.Parent) then return true end
        local p = pps[1]
        if p and (not p.Parent or not p.Enabled) then return true end
        return false
    end

    do
        local p1 = pps[1]
        local dd = p1 and ppPos(p1) and (ppPos(p1) - hrp.Position).Magnitude or -1
        if p1 then
            setStatus("Drücke E: " .. (p1.ObjectText ~= "" and p1.ObjectText or p1.ActionText), "Pressing E: " .. (p1.ObjectText ~= "" and p1.ObjectText or p1.ActionText))
        else
            setStatus("Kein Prompt gefunden - drücke E", "No prompt found - pressing E")
        end
        print(string.format("[AntonioHub] Prompts: %d | Obj='%s' Act='%s' Hold=%.2f Dist=%.1f | fire=%s",
            #pps, p1 and p1.ObjectText or "-", p1 and p1.ActionText or "-", p1 and p1.HoldDuration or 0, dd, tostring(fireproximityprompt ~= nil)))
    end
    for attempt = 1, 4 do
        -- 1) Prompt per Executor-Funktion auslösen
        if fireproximityprompt then
            for _, pp in ipairs(pps) do pcall(fireproximityprompt, pp) end
        end
        -- 2) Prompt-Eingabe direkt simulieren (hält die HoldDuration ein)
        local pp1 = pps[1]
        if pp1 then
            pcall(function()
                pp1:InputHoldBegin()
                task.wait((pp1.HoldDuration or 0) + 0.1)
                pp1:InputHoldEnd()
            end)
        end
        -- 3) ab dem 2. Versuch zusätzlich echte E-Taste
        if attempt >= 2 or not pp1 then
            pcall(function()
                VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(math.max(pp1 and pp1.HoldDuration or 0, 0.05) + 0.12)
                VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end)
        end
        local t1 = tick()
        while tick() - t1 < 0.6 and not gone() do task.wait(0.05) end
        if gone() or not F.on then break end
    end

    pin:Disconnect()
    return gone()
end

-- Einmal auf den Boden vor dem Charakter klicken (Ei platzieren)
function F.place(hrp)
    local cam = workspace.CurrentCamera
    local look = cam.CFrame.LookVector
    local dir = Vector3.new(look.X, 0, look.Z)
    dir = dir.Magnitude > 0.01 and dir.Unit or hrp.CFrame.LookVector
    local p = hrp.Position + dir * 8 - Vector3.new(0, 3, 0)
    local v, on = cam:WorldToScreenPoint(p)
    local x, y
    if on then
        x, y = v.X, v.Y
    else
        local vs = cam.ViewportSize
        x, y = vs.X / 2, vs.Y * 0.65
    end
    pcall(function()
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

function F.goHome()
    local hrp = getChar()
    if hrp and F.home then tp(hrp, F.home) return true end
    return false
end

task.spawn(function()
    while g.Parent do
        if not F.on then
            F.wake.Event:Wait()
            if not g.Parent then break end
        end
        if not F.on then continue end

        local hrp = getChar()
        if not hrp then
            task.wait(0.5)
            continue
        end

        -- Kein Home gesetzt -> aktuelle Position als Home übernehmen
        if not F.home then
            F.home = hrp.CFrame
            F.save()
            if F.onHome then pcall(F.onHome) end
        end

        local it = F.find(hrp.Position)
        if not it then
            setStatus("Aktuell keins da", "None available right now")
            task.wait(1.5)
        else
            local nm = (F.sel ~= 0 and (E[F.sel][1]:gsub(" %(alle%)",""):gsub("[ %-]Ei$",""))) or X.base(it) or it.n or "Ei"
            if type(nm) ~= "string" or nm == "" then nm = "Ei" end
            setStatus("Hole Ei: " .. nm, "Fetching egg: " .. nm)

            local got = F.grab(it, hrp)
            local t = it.tgt
            if got then
                F.tries[t] = nil
                F.skip[t] = tick() + 3
            else
                local n = (F.tries[t] or 0) + 1
                F.tries[t] = n
                F.skip[t] = tick() + 5 * n
            end

            if F.on then
                setStatus("Zurück zu Home...", "Returning home...")
                local hrp2 = getChar()
                if hrp2 and F.home then
                    tp(hrp2, F.home)
                    local pin = F.pin(hrp2, F.home)   -- am Home festhalten
                    task.wait(0.45)
                    F.place(hrp2)
                    task.wait(0.6)
                    pin:Disconnect()
                end
            end
        end
    end
end)
end

