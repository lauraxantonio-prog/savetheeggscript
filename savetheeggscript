local active,marks={},{}
local function make(o,i,it)
    local col=COL[i]
    local hl=new("Highlight",{Adornee=o,FillColor=col,OutlineColor=col,FillTransparency=1,OutlineTransparency=0,
        DepthMode=Enum.HighlightDepthMode.AlwaysOnTop},g)
    local part=o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart",true)
    local bb=new("BillboardGui",{Adornee=part,AlwaysOnTop=true,Size=UDim2.new(0,260,0,90),StudsOffset=Vector3.new(0,6,0),MaxDistance=math.huge},g)
    local lb=new("TextLabel",{Size=UDim2.new(1,0,0,70),Position=UDim2.new(0,0,0,0),BackgroundTransparency=1,TextColor3=col,
        TextStrokeTransparency=0,TextSize=S.textSize,TextWrapped=true,Font=FONTB},bb)
    local ln
    if Drawing then ln=Drawing.new("Line") ln.Color=col ln.Thickness=S.tracerThick ln.Visible=false end
    local e=E[i]
    local mutSuffix = ""
    if it.s == 2 and not has(it.n:lower(), "rainbow") then mutSuffix = " (Rainbow)"
    elseif it.s == 3 and not has(it.n:lower(), "retro") then mutSuffix = " (Retro)"
    elseif it.s == 1 and not has(it.n:lower(), "gold") then mutSuffix = " (Gold)" end
    local nm=(e[3] and it.n~="" and has(it.n:lower(),unpack(e[2])) and it.n) or e[1]
    marks[o]={hl=hl,bb=bb,lb=lb,ln=ln,col=col,part=part,rb=e[4],kt=it.kt,
        sz=it.sz, t=nm..mutSuffix, vis=true}
end

local function matchE(e,it)
    if e[6] and has(it.kt,unpack(e[6])) then return false end
    return has(it.kt,unpack(e[2])) and (e[5] and eggStrict(it) or (not e[5] and (not e[3] or it.txt or isEggT(it.kt) or eggCtx(it.tgt))))
end

local function scan()
    local r=P.Character and P.Character:FindFirstChild("HumanoidRootPart")
    local items=buildItems(r and r.Position or Vector3.new(0,0,0))
    local want,seen={}, {}
    for i,e in ipairs(E) do
        if active[i] then
            for _,it in ipairs(items) do
                if not seen[it.tgt] and matchE(e,it) then
                    if not (it.ign and not SHOW_BASES) then
                        seen[it.tgt]=true
                        local okS, sz = pcall(function() local t = it.tgt return t:IsA("Model") and t:GetExtentsSize() or t.Size end)
                        it.sz = (okS and sz) and math.max(sz.X, sz.Y, sz.Z) or 0
                        want[#want+1]={i=i,it=it}
                    end
                end
            end
        end
    end
    table.sort(want,function(a,b)
        local ma,mb=marks[a.it.tgt]~=nil,marks[b.it.tgt]~=nil
        if ma~=mb then return ma end
        return a.it.d<b.it.d
    end)
    local alive,acc,n={}, {}, 0
    for _,w in ipairs(want) do
        if n>=S.maxMarks then break end
        local dup=false
        for _,q in ipairs(acc) do
            if q.i==w.i and (q.p-w.it.pos).Magnitude<10 then dup=true break end
        end
        if not dup then
            acc[#acc+1]={i=w.i,p=w.it.pos}
            alive[w.it.tgt]=true n=n+1
            if not marks[w.it.tgt] then make(w.it.tgt,w.i,w.it) end
            local m=marks[w.it.tgt]
            m.sz = w.it.sz
            local names,got,rbw={}, {}, false
            for _,ej in ipairs(E) do
                if matchE(ej,w.it) then
                    local sn=ej[1]:gsub(" %(alle%)","")
                    names[#names+1]=sn got[sn]=true
                    if ej[4] then rbw=true end
                end
            end
            if w.it.s==2 and not got["Rainbow"] then names[#names+1]="Rainbow" rbw=true end
            if w.it.s==3 and not got["Retro"] then names[#names+1]="Retro" rbw=true end
            if w.it.s==1 and not got["Gold"] then names[#names+1]="Gold" end
            if #names>0 then
                -- Nur Mutationen erkannt -> Ei-Namen dazuschreiben (z.B. "Gold | Dragon Egg")
                local onlyMut=true
                for _,nme in ipairs(names) do
                    if not X.mut[nme] then onlyMut=false break end
                end
                local label=table.concat(names," + ")
                if onlyMut then
                    local base=X.base(w.it)
                    if base then label=label.." | "..base end
                end
                m.t=label
            end
            m.rb=rbw
        end
    end

    for o,m in pairs(marks) do
        if not alive[o] or not o.Parent then
            m.hl:Destroy() m.bb:Destroy() if m.ln then pcall(function() m.ln:Remove() end) end marks[o]=nil
        end
    end
end

