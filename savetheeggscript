function X.cfgCollect()
    local d={}
    for _,it in ipairs(X.cfgItems) do
        local ok,v=pcall(it.get)
        if ok and v~=nil then d[it.key]=v end
    end
    return d
end
function X.cfgEncode()
    local ok,js=pcall(function() return HS2:JSONEncode(X.cfgCollect()) end)
    return ok and js or nil
end
function X.cfgSave(force)
    if not (X.cfgOn or force) then return end
    local js=X.cfgEncode()
    if not js or (js==X.cfgLast and not force) then return end
    X.cfgLast=js
    genv.AntonioHubCfg=js
    pcall(function() if writefile then writefile(CFG_FILE,js) end end)
end
function X.cfgDelete()
    pcall(function() if delfile and isfile and isfile(CFG_FILE) then delfile(CFG_FILE) end end)
    genv.AntonioHubCfg=nil
    X.cfgLast=X.cfgEncode()
end
function X.cfgLoad()
    local js
    pcall(function() if isfile and readfile and isfile(CFG_FILE) then js=readfile(CFG_FILE) end end)
    js=js or genv.AntonioHubCfg
    if type(js)~="string" then return false end
    local ok,d=pcall(function() return HS2:JSONDecode(js) end)
    if not ok or type(d)~="table" then return false end
    for _,it in ipairs(X.cfgItems) do
        local v=d[it.key]
        if v~=nil then pcall(it.apply,v) end
    end
    return true
end

