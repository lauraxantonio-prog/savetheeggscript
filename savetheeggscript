local hideOn = {}
local hideGen = {}
local hideSaved = setmetatable({}, {__mode="k"})
local hideCat = setmetatable({}, {__mode="k"})

local function smallEnough(o,d)
    local ok,sz=pcall(function() return o.Size end)
    if not ok or math.max(sz.X,sz.Y,sz.Z)>d.maxSize then return false end
    local a=o.Parent
    for _=1,3 do
        if not a or a==workspace then break end
        if a:IsA("Model") and has(a.Name:lower(),unpack(d.kw)) then
            local ok2,ms=pcall(function() return a:GetExtentsSize() end)
            if ok2 and math.max(ms.X,ms.Y,ms.Z)>d.maxSize*2 then return false end
            break
        end
        a=a.Parent
    end
    return true
end

local function classify(o)
    local c = hideCat[o]
    if c ~= nil then return c end
    local res = false
    local t = o.Name
    local a = o.Parent
    for _=1,3 do
        if a and a ~= workspace then t = t.." "..a.Name a = a.Parent else break end
    end
    t = t:lower()
    local own = (o.Name.." "..(o.Parent and o.Parent.Name or "")):lower()
    if not has(t,"egg","eier","diamond") and not belongsToHumanoid(o) then
        for _,id in ipairs(HIDE_ORDER) do
            local d = HIDE_BY[id]
            if has(t,unpack(d.kw)) and (not d.need or has(t,unpack(d.need)))
                and not (d.no and has(t,unpack(d.no)))
                and not (d.noSelf and has(own,unpack(d.noSelf)))
                and (not d.maxSize or smallEnough(o,d)) then
                res = id
                break
            end
        end
        -- Fallback: Felsen ohne sprechenden Namen anhand des Materials
        if not res and o:IsA("BasePart") and HIDE_BY.rock.mats[o.Material] then
            local d = HIDE_BY.rock
            local ok, sz = pcall(function() return o.Size end)
            if ok and not has(t,unpack(d.no)) and not has(own,unpack(d.noSelf)) then
                local mx, mn = math.max(sz.X,sz.Y,sz.Z), math.min(sz.X,sz.Y,sz.Z)
                local fine = mx <= 18 and mn*4 >= mx          -- klein & "klobig" (keine Wände/Böden)
                local p = o.Parent
                if fine and p and p ~= workspace and p:IsA("Model") then
                    local ok2, ms = pcall(function() return p:GetExtentsSize() end)
                    if ok2 and math.max(ms.X,ms.Y,ms.Z) > 40 then fine = false end
                end
                local b = o.Parent
                while fine and b and b ~= workspace do
                    if has(b.Name:lower(),"base","plot","spawn") then fine = false end
                    b = b.Parent
                end
                if fine then res = "rock" end
            end
        end
    end
    hideCat[o] = res
    return res
end

local function hidePart(o)
    if hideSaved[o] == nil then hideSaved[o] = o.Transparency end
    o.Transparency = 1
end

local function setHide(id, v)
    hideOn[id] = v or nil
    hideGen[id] = (hideGen[id] or 0) + 1
    local gen = hideGen[id]
    if v then
        task.spawn(function()
            local list = workspace:GetDescendants()
            for i = 1, #list do
                if hideGen[id] ~= gen then return end
                local o = list[i]
                if o:IsA("BasePart") and o.Parent and classify(o) == id then pcall(hidePart, o) end
                if i % 600 == 0 then task.wait() end
            end
        end)
    else
        for o, orig in pairs(hideSaved) do
            if hideCat[o] == id then
                if o.Parent then pcall(function() o.Transparency = orig end) end
                hideSaved[o] = nil
            end
        end
    end
end

local function restoreAllHidden()
    for id in pairs(hideGen) do hideGen[id] = hideGen[id] + 1 end
    for o, orig in pairs(hideSaved) do
        if o.Parent then pcall(function() o.Transparency = orig end) end
        hideSaved[o] = nil
    end
    hideOn = {}
end

