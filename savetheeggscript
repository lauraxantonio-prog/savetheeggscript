    for plr in pairs(playerMarks) do
        if not plr.Parent then killPM(plr) end
    end
    local r = P.Character and P.Character:FindFirstChild("HumanoidRootPart")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= P then
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local dist = (r and hrp) and (hrp.Position - r.Position).Magnitude or 0
            local ok = playerEspOn and hrp and hum and hum.Health > 0 and dist <= PS.maxDist
            if ok then
                local m = playerMarks[plr]
                if m and m.hrp ~= hrp then killPM(plr) m = nil end
                if not m then
                    local hl = new("Highlight", {Adornee = char, FillTransparency = 1, OutlineTransparency = 0,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, g)
