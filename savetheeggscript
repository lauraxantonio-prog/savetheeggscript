--// Registry: alle speicherbaren Controls (Schlüssel = Abschnitt/Name)
X.cfgItems={} X.cfgKeys={} X.curSec=""
X.noSave={["Performance/3D-Rendering aus"]=true,["Speichern/Auto-Speichern"]=true}
function X.reg(name,get,apply)
    local n=type(name)=="table" and name[1] or tostring(name)
    local key=X.curSec.."/"..n
    if X.cfgKeys[key] then
        local i=2
        while X.cfgKeys[key.."#"..i] do i=i+1 end
        key=key.."#"..i
    end
    X.cfgKeys[key]=true
    if X.noSave[key] then return end
    X.cfgItems[#X.cfgItems+1]={key=key,get=get,apply=apply}
end

