function X.fmtNum(v)
    if type(v)~="number" then return tostring(v) end
    local a=math.abs(v)
    if a>=1e9 then return string.format("%.1fB",v/1e9)
    elseif a>=1e6 then return string.format("%.1fM",v/1e6)
    elseif a>=1e3 then return string.format("%.1fK",v/1e3) end
    return tostring(math.floor(v*100+0.5)/100)
end

