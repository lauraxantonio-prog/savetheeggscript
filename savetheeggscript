--// HILFSFUNKTIONEN (Diamond, mit Shop/Potion-Filter)
local function isEggOrPropRelated(o)
    local blacklistedKeywords = {
        "egg", "prop", "potion", "trank", "shop", "buy", "kauf",
        "vendor", "merchant", "stand", "seller", "npc"
    }
    local a = o
    while a and a ~= workspace do
        local name = a.Name:lower()
        for _, kw in ipairs(blacklistedKeywords) do
            if name:find(kw, 1, true) then return true end
        end
        a = a.Parent
    end
    local pp = o:FindFirstChildWhichIsA("ProximityPrompt", true)
    if pp then
        local text = (pp.ActionText .. " " .. pp.ObjectText):lower()
        for _, kw in ipairs(blacklistedKeywords) do
            if text:find(kw, 1, true) then return true end
        end
    end
    return false
end

local function belongsToHumanoid(o)
    local a = o
    while a and a ~= workspace do
        if a:FindFirstChildOfClass("Humanoid") then return true end
        a = a.Parent
    end
    return false
end

-- Diamond ESP: Highlight + Label (Parent = Menü-GUI, wird beim Entladen mit entfernt)
local function updateDiamondHighlight(e, state)
    if state and diamondEspOn then
        local o = e.obj
        if not (e.part and e.part.Parent) then
            e.part = (o and o.Parent) and (o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart", true)) or nil
        end
        if not e.part then return end
        local adornee = (o and o:IsA("Model")) and o or e.part
        if e.highlight and e.highlight.Adornee ~= adornee then
            pcall(function() e.highlight:Destroy() end) e.highlight = nil
            pcall(function() e.bb:Destroy() end) e.bb = nil e.lb = nil
        end
        if not e.highlight then
            local root = X.root or adornee
            local hl = Instance.new("Highlight")
            hl.FillColor = Color3.fromRGB(0, 240, 255)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = adornee
            hl.Parent = root
            e.highlight = hl

            local bb = Instance.new("BillboardGui")
            bb.Adornee = e.part
            bb.AlwaysOnTop = true
            bb.Size = UDim2.new(0, 140, 0, 36)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.MaxDistance = math.huge
            bb.Parent = root
            local lb = Instance.new("TextLabel")
            lb.Size = UDim2.new(1, 0, 1, 0)
            lb.BackgroundTransparency = 1
            lb.Font = Enum.Font.GothamBold
            lb.TextSize = 14
            lb.TextColor3 = Color3.fromRGB(0, 240, 255)
            lb.TextStrokeTransparency = 0
            lb.Text = "Diamond"
            lb.Parent = bb
            e.bb, e.lb = bb, lb
        end
    else
        if e.highlight then pcall(function() e.highlight:Destroy() end) e.highlight = nil end
        if e.bb then pcall(function() e.bb:Destroy() end) e.bb = nil e.lb = nil end
    end
end

do
local function trackDiamond(o)
    if diamonds[o] then return end
    if not (o:IsA("BasePart") or o:IsA("Model")) then return end
    if not o.Name:lower():find("diamond", 1, true) then return end
    if isEggOrPropRelated(o) then return end
    diamonds[o] = {
        obj = o,
        skipUntil = 0, tries = 0,
        bad = false, badUntil = 0,
        vis = false, visUntil = 0,
        part = nil, highlight = nil, bb = nil, lb = nil,
    }
end

task.spawn(function()
    local list = workspace:GetDescendants()
    for i = 1, #list do
        trackDiamond(list[i])
        if i % 1500 == 0 then task.wait() end
    end
end)
bind(workspace.DescendantAdded, trackDiamond)
bind(workspace.DescendantRemoving, function(o)
    if diamonds[o] then
        updateDiamondHighlight(diamonds[o], false)
        diamonds[o] = nil
    end
end)

end

local function getDiamondPart(o, e)
    local p = e.part
    if p and p.Parent then return p end
    if o:IsA("BasePart") then p = o else p = o:FindFirstChildWhichIsA("BasePart", true) end
    e.part = p
    if p and diamondEspOn then updateDiamondHighlight(e, true) end
    return p
end

local isVisible
do
local function rawVisible(o)
    if o:IsA("BasePart") then return o.Transparency < 0.95 end
    for _, d in ipairs(o:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 0.95 then return true end
    end
    return false
end

function isVisible(o, e, now)
    if now >= e.visUntil then
        e.vis = rawVisible(o)
        e.visUntil = now + VIS_TTL
    end
    return e.vis
end
end

local function isInteractive(o)
    return o:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil
        or o:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
end

local function isBad(o, e, now)
    if now >= e.badUntil then
        e.bad = belongsToHumanoid(o) or isEggOrPropRelated(o)
        e.badUntil = now + STATIC_TTL
    end
    return e.bad
end

-- Remote Listener für DiamondRush
do
    local pa = ReplicatedStorage:FindFirstChild("PetAscent")
    local ev = pa and pa:FindFirstChild("DiamondRush")
    if ev and ev:IsA("RemoteEvent") then
        bind(ev.OnClientEvent, function(data)
            if type(data) ~= "table" then return end
            if data.kind == "pickup" then
                collectedCount = collectedCount + 1
                if typeof(data.position) == "Vector3" then
                    local best, bestD
                    for o, e in pairs(diamonds) do
                        local part = getDiamondPart(o, e)
                        if part then
                            local d = (part.Position - data.position).Magnitude
                            if d <= 25 and (not bestD or d < bestD) then best, bestD = e, d end
                        end
                    end
                    if best then
                        best.skipUntil = tick() + PICKUP_SKIP
                        best.tries = 0
                    end
                end
            end
        end)
    end
end

