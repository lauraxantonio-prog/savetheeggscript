local function save()
 if not canFile or saveQueued or noSave then return end
 saveQueued=true
 task.delay(1,function()
  saveQueued=false
  if noSave then return end
  pcall(function() writefile(FILE,HttpService:JSONEncode(S)) end)
 end)
end

