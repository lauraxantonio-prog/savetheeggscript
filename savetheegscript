 head(sp,"cfg_head")
 do
  local SKIP={configs=true,nfHook=true,hkMsgId=true,hkMsgJob=true,hkPing=true,homes=true,eggsInit=true,nfInit=true,espv=true,whv=true,fuseEnd=true,autoload=true}
  local function deep(v)
   if type(v)~="table" then return v end
   local t={}
   for k,x in pairs(v) do t[k]=deep(x) end
   return t
  end
  local function snapshot()
   local t={}
   for k,v in pairs(S) do if not SKIP[k] then t[k]=deep(v) end end
   return t
  end
  local function sanitize(src)
   local t={}
   for k,v in pairs(src) do
    if not SKIP[k] and S[k]~=nil and type(v)==type(S[k]) then t[k]=deep(v) end
   end
   return t
  end
  local function cleanName(s)
   s=(s or ""):gsub("^%s+",""):gsub("%s+$","")
