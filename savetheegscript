   S.configs[n]=sanitize(d)
   nameBox.Text=n
   impBox.Text=""
   save()
   refreshList()
   notify(tr("cfg_import_ok"),C.good,true)
  end)
  makeLabelBox(sp,"cfg_info",nil,76)
 end

