 end
 add(best)
 if base~=best then add(base) end
 local own=TYPES[ti].text
 local g=s:find("%f[%a]gold%f[%A]")~=nil and own~="gold egg"
 local d=(s:find("diamond",1,true)~=nil or s:find("diamant",1,true)~=nil) and own~="diamond egg"
