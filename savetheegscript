 -- neu in v3.1
 tpHeight=5,scanInt=10,shortNames=false,hlOutline=true,showTips=true,countOnlyFound=true,countSort=1,
}
do
 if canFile then
  pcall(function()
   if isfile(FILE) then
    local d=HttpService:JSONDecode(readfile(FILE))
    for k,v in pairs(d) do
     if S[k]~=nil and type(v)==type(S[k]) then S[k]=v end
    end
   end
  end)
 end
end
local noSave,saveQueued=false,false
local function save()
 if not canFile or saveQueued or noSave then return end
 saveQueued=true
 task.delay(1,function()
  saveQueued=false
  if noSave then return end
  pcall(function() writefile(FILE,HttpService:JSONEncode(S)) end)
 end)
end

