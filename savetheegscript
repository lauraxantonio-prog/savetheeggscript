 --// ---------- Hitbox ----------
 local function hbRestore(part)
  local o=hbOrig[part]
  if not o then return end
  pcall(function()
   part.Size=o.s part.Transparency=o.t part.CanCollide=o.c
   part.Color=o.col part.Material=o.m
  end)
  hbOrig[part]=nil
 end
 local function hbRestoreAll()
  for part in pairs(hbOrig) do hbRestore(part) end
 end
 local function hbApply(part,size,trans,col)
  local o=hbOrig[part]
  if not o then
   o={s=part.Size,t=part.Transparency,c=part.CanCollide,col=part.Color,m=part.Material,p=false}
   hbOrig[part]=o
  end
  pcall(function()
   if part.Size~=size then part.Size=size end
   part.Transparency=trans
   part.CanCollide=false
   if col then
    part.Color=col
    part.Material=Enum.Material.Neon
    o.p=true
   elseif o.p then
    part.Color=o.col
    part.Material=o.m
    o.p=false
   end
  end)
 end
