   if type(c)~="table" then notify(tr("cfg_none"),C.bad,true) return end
   if not canFile then notify(tr("cfg_nofile"),C.bad,true) return end
   for k,v in pairs(sanitize(c)) do S[k]=v end
   pcall(function() writefile(FILE,HttpService:JSONEncode(S)) end)
   notify(tr("cfg_loaded"),C.good,true)
   task.delay(1.4,function() closeHub() end)
  end,2)
  makeButton(g,"cfg_del","bad",function()
   local n=cleanName(nameBox.Text)
   if S.configs[n]==nil then notify(tr("cfg_none"),C.bad,true) return end
   S.configs[n]=nil
   save()
   refreshList()
   notify(tr("cfg_deleted"),C.good,true)
  end,3)

  makeButton(sp,"cfg_export",Color3.fromRGB(70,74,100),function()
