 if b:IsA("GuiButton") then
  if firesignal then
   for _,s in ipairs({b.MouseButton1Down,b.MouseButton1Up,b.MouseButton1Click,b.Activated}) do pcall(firesignal,s) end
   usedSignal=true
  elseif getconnections then
   for _,s in ipairs({b.MouseButton1Click,b.Activated}) do
    for _,c in ipairs(getconnections(s)) do pcall(function() c:Fire() end) end
   end
   usedSignal=true
  end
 end
 if coords or not usedSignal then
  local sgui=b:FindFirstAncestorOfClass("ScreenGui")
  local inset=(sgui and sgui.IgnoreGuiInset) and Vector2.new(0,0) or GS:GetGuiInset()
  local c=b.AbsolutePosition+b.AbsoluteSize/2+inset
  pcall(function()
   VIM:SendMouseButtonEvent(c.X,c.Y,0,true,game,0)
   task.wait(0.03)
   VIM:SendMouseButtonEvent(c.X,c.Y,0,false,game,0)
  end)
 end
end

task.spawn(function()
 while alive do
  if quickOn then
   local now=tick()
   for o in pairs(qc) do
    if not o.Parent then
     qc[o]=nil clicked[o]=nil firstSeen[o]=nil lastClick[o]=nil
    elseif visible(o) then
     firstSeen[o]=firstSeen[o] or now
     local n=clicked[o] or 0
     local due=(n==0 and now-firstSeen[o]>=QUICK_DELAY) or (n>0 and now-(lastClick[o] or 0)>=QUICK_RETRY)
     if n<QUICK_TRIES and due then
      clicked[o]=n+1
      lastClick[o]=now
      if n==0 then quickClicks=quickClicks+1 end
      pcall(press,clickTarget(o),n>=1)
      setFarmStatus(trf("a_clicked",n+1))
     end
    else
     clicked[o]=nil firstSeen[o]=nil lastClick[o]=nil
    end
   end
  end
  task.wait(0.1)
 end
end)
end

