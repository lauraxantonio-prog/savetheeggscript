    new("UIPadding",{PaddingLeft=UDim.new(0,10)},b)
    b.MouseButton1Click:Connect(function() nameBox.Text=n end)
    rowsC[#rowsC+1]=b
   end
  end
  refreshList()

  local g=new("Frame",{Size=UDim2.new(1,0,0,38),BackgroundTransparency=1,LayoutOrder=ord(sp)},sp)
  new("UIGridLayout",{CellSize=UDim2.new(1/3,-7,0,38),CellPadding=UDim2.fromOffset(10,10),SortOrder=Enum.SortOrder.LayoutOrder},g)
  makeButton(g,"cfg_save","acc",function()
   local n=cleanName(nameBox.Text)
   if n=="" then notify(tr("cfg_noname"),C.bad,true) return end
   S.configs[n]=snapshot()
   save()
   refreshList()
   notify(tr("cfg_saved"),C.good,true)
  end,1)
  makeButton(g,"cfg_load",Color3.fromRGB(90,60,200),function()
