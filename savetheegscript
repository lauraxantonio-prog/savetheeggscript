  local q=string.lower(qBox.Text)
  local items,total={}, 0
  for _,pl in ipairs(Players:GetPlayers()) do
   if pl~=P then
    total=total+1
    if q=="" or string.find(string.lower(pl.Name),q,1,true) or string.find(string.lower(pl.DisplayName),q,1,true) then
     local hrp=pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
     local hum=pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
     items[#items+1]={pl=pl,hum=hum,hp=hum and hum.Health or math.huge,d=(hrp and myh) and (hrp.Position-myh.Position).Magnitude or math.huge}
    end
   end
  end
  if S.peSort==2 then
   table.sort(items,function(a,b) if a.hp~=b.hp then return a.hp<b.hp end return a.d<b.d end)
  elseif S.peSort==3 then
   table.sort(items,function(a,b) return a.pl.DisplayName:lower()<b.pl.DisplayName:lower() end)
  else
   table.sort(items,function(a,b) return a.d<b.d end)
  end
  X.order={}
  for i,it in ipairs(items) do X.order[i]=it.pl end
  cntLbl.Text=trf("pl_count",total)
  noneLbl.Parent.Visible=(#items==0)
  local nearest
  for _,it in ipairs(items) do
   if it.d<math.huge and (not nearest or it.d<nearest.d) then nearest=it end
  end
  nearLbl.Parent.Visible=(nearest~=nil)
  if nearest then nearLbl.Text=trf("pl_near",nearest.pl.DisplayName,math.floor(nearest.d)) end
  for i,it in ipairs(items) do
   local r=getRow(i)
   local pl=it.pl
   r.pl=pl
   r.f.Visible=true
   r.f.LayoutOrder=1000+i
   r.nm.Text=pl.DisplayName.."  (@"..pl.Name..")"
   local s=(it.d<math.huge) and (math.floor(it.d).." m") or "-"
   if it.hum then s=s.."  •  "..math.floor(it.hum.Health).." HP" end
   if pl.Team then s=s.."  •  "..pl.Team.Name end
