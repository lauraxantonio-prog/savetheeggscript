 do
  local hooked=setmetatable({},{__mode="k"})
  local checked=setmetatable({},{__mode="k"})
  local function isFuse(p)
   local t=((p.ObjectText or "").." "..(p.ActionText or "")):lower()
   return t:find("fuse",1,true) or t:find("fusion",1,true) or t:find("maschin",1,true) or t:find("machine",1,true)
  end
  task.spawn(function()
   local lastReset=tick()
   while alive do
    if S.fuseOn then
     if tick()-lastReset>30 then
      lastReset=tick()
      for k in pairs(checked) do checked[k]=nil end
     end
     for p in pairs(prompts) do
      if p.Parent and not hooked[p] and not checked[p] then
       checked[p]=true
       if isFuse(p) then
        hooked[p]=true
        conn(p.Triggered:Connect(function(plr)
         if S.fuseOn and (plr==nil or plr==P) then fuseStart() end
        end))
       end
      end
     end
    end
    task.wait(3)
   end
  end)
 end

