-- Text normalisieren: Kleinbuchstaben, Tags weg, "&" = "and", nur Buchstaben/Zahlen
local typeOfPrompt,targetOf,sizeOf,partOf,addPrompt
do
local function norm(s)
 s=string.lower(s or "")
 s=s:gsub("<[^>]+>","")
 s=s:gsub("&amp;","&")
 s=s:gsub("&"," and ")
 s=s:gsub("[^%a%d]","")
 return s
end
local KEY2IDX,KEYLIST={}, {}
for i,ty in ipairs(TYPES) do
 local k=norm(ty.text)
 KEY2IDX[k]=i
 KEYLIST[#KEYLIST+1]={k=k,i=i}
end
table.sort(KEYLIST,function(a,b) return #a.k>#b.k end)
local mcache={}
local function matchKey(s)
 if s==nil or s=="" then return nil end
 local c=mcache[s]
 if c~=nil then return c or nil end
 local k=norm(s)
 local r
 if k~="" then
  r=KEY2IDX[k]
  if not r then
   for _,e in ipairs(KEYLIST) do
    if string.find(k,e.k,1,true) then r=e.i break end
   end
  end
 end
 mcache[s]=r or false
 return r
end

function typeOfPrompt(p)
 local ti=matchKey(p.ObjectText)
 if ti then return ti end
 ti=matchKey(p.ActionText)
 if ti then return ti end
 local a=p.Parent
 for _=1,2 do
  if not a then break end
  if a:IsA("Attachment") then a=a.Parent end
  if not a or a==workspace then break end
  ti=matchKey(a.Name)
  if ti then return ti end
  a=a.Parent
 end
 return nil
end

function sizeOf(o)
 local ok,s=pcall(function()
  if o:IsA("Model") then return o:GetExtentsSize() end
  return o.Size
 end)
 if ok and s then return s end
end
local function tooBig(o)
 local s=sizeOf(o)
 return s~=nil and math.max(s.X,s.Y,s.Z)>MAXSIZE
end
function partOf(o)
 if not o then return nil end
 if o:IsA("BasePart") then return o end
 if o:IsA("Model") then return o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart",true) end
 return nil
end

local function eggTarget(p)
 local base=p.Parent
 if base and base:IsA("Attachment") then base=base.Parent end
 if not base then return nil end
 local best=base
 local a=base.Parent
 for _=1,3 do
  if not a or a==workspace or not a:IsA("Model") then break end
  if tooBig(a) then break end
  best=a
  a=a.Parent
 end
 return best,base
end
local tcache=setmetatable({},{__mode="k"})
function targetOf(p,now)
 local e=tcache[p]
 if e and now-e.t<3 and e.best.Parent and e.base.Parent then return e.best,e.base end
 local best,base=eggTarget(p)
 if best then tcache[p]={best=best,base=base,t=now} end
 return best,base
end

