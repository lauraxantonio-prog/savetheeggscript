local function updateTargets()
 local now=tick()
 local c=P.Character
 local hrp=c and c:FindFirstChild("HumanoidRootPart")
 local hrpPos=hrp and hrp.Position
 local items={}
 for p in pairs(prompts) do
  if not p.Parent then
   prompts[p]=nil
  else
   local ti=typeOfPrompt(p)
   if ti then
    local best,base=targetOf(p,now)
    if best and not (c and best:IsDescendantOf(c)) then
     items[#items+1]={ti=ti,best=best,base=base,mut=HK.mutOf(p,best,base,ti)}
    end
   end
  end
 end
 if #items==0 and S.nameScan then
  for o,ti in pairs(named) do
   if not o.Parent then
    named[o]=nil
   elseif not inPlayer(o) then
    local sz=sizeOf(o)
    if not (sz and math.max(sz.X,sz.Y,sz.Z)>MAXSIZE) and partOf(o) then
     items[#items+1]={ti=ti,best=o,base=o,mut=0}
    end
   end
  end
 end
 local groups={}
 for _,it in ipairs(items) do
  local g=groups[it.best]
  if not g then g={} groups[it.best]=g end
  g[#g+1]=it
 end
 local final,fmut={}, {}
 for best,g in pairs(groups) do
  local split=false
  if #g>1 then
   local p1=partOf(g[1].base)
   for i=2,#g do
    local it=g[i]
    if it.ti~=g[1].ti then split=true break end
    if it.base~=g[1].base then
     local p2=partOf(it.base)
     if p1 and p2 and (p1.Position-p2.Position).Magnitude>8 then split=true break end
    end
   end
  end
  if split then
   for _,it in ipairs(g) do final[it.base]=it.ti fmut[it.base]=it.mut end
  else
   local mm=0
   for _,it in ipairs(g) do if (it.mut or 0)>mm then mm=it.mut end end
   final[best]=g[1].ti
   fmut[best]=mm
  end
 end
 local seen={}
 for t,ti in pairs(final) do
  local pt=partOf(t)
  if pt and pt.Parent then
   local pos=pt.Position
   local k=objKey[t]
   local e=k and cache[k]
   if not (e and e.ti==ti and not seen[k]) then
    e=nil k=nil
    local bestD=10
    for ck,ce in pairs(cache) do
     if ce.ti==ti and not seen[ck] and (not ce.obj or not ce.obj.Parent) then
      local dd=(ce.pos-pos).Magnitude
      if dd<bestD then bestD=dd k=ck e=ce end
     end
    end
    if not e then
     keyN=keyN+1
     k="e"..keyN
     e={ti=ti}
     cache[k]=e
    end
    objKey[t]=k
   end
   e.obj=t e.pos=pos e.live=true e.t=now e.mut=fmut[t] or 0
   if not e.big then
    local sz=sizeOf(t)
    e.big=sz and math.max(sz.X,sz.Y,sz.Z) or 0
   end
   seen[k]=true
  end
 end
 local en,sr=streamingInfo()
 local rem=sr*0.6
 for k,e in pairs(cache) do
  if not seen[k] then
   e.live=false e.obj=nil
   local drop=false
   if not S.ghost or not en then drop=true
   elseif hrpPos and (e.pos-hrpPos).Magnitude<rem then drop=true
   elseif now-(e.t or now)>1800 then drop=true end
   if drop then cache[k]=nil end
  end
 end
 local vis={}
 for k,e in pairs(cache) do
  if not inHomeZone(e.pos) and not (S.mutOnly and not HK.isMut(e)) then vis[k]=e end
 end
 local want,counts,all={}, {}, {}
 for k,e in pairs(vis) do
  all[e.ti]=(all[e.ti] or 0)+1
  if TYPES[e.ti].on then
   counts[e.ti]=(counts[e.ti] or 0)+1
   if S.espOn then want[k]=e end
  end
 end
 for k,e in pairs(want) do
  local m=marks[k]
  if m then
   local okm=(m.ti==e.ti) and (m.obj==e.obj) and m.part and m.part.Parent
   if okm and e.obj then okm=(m.part==e.obj or m.part:IsDescendantOf(e.obj)) end
   if not okm then unmark(k) m=nil end
  end
  if not m then pcall(mark,k,e) end
  local mm=marks[k]
  if mm then mm.mut=e.mut or 0 end
 end
 for k in pairs(marks) do
  if not want[k] then unmark(k) end
 end
 allCounts=all
 lastCounts=counts
 lastTargets=vis
 return counts
end

