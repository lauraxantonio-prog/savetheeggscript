local function httpGet(url)
 local ok,res=pcall(function() return game:HttpGet(url) end)
 if ok and type(res)=="string" and #res>0 then return res end
 local req=(syn and syn.request) or request or http_request or (http and http.request)
 if req then
  local ok2,r=pcall(req,{Url=url,Method="GET"})
  if ok2 and r and r.Body then return r.Body end
 end
 return nil
end

local function serverHop()
 if hopping then return end
 hopping=true
 task.spawn(function()
  setToolStatus(tr("srv_search"))
  local picked
  pcall(function()
   local url="https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
   local body=httpGet(url)
   if not body then return end
   local data=HttpService:JSONDecode(body)
   local pool={}
   for _,s in ipairs(data.data or {}) do
    if s.id~=game.JobId and s.playing and s.maxPlayers and s.playing<s.maxPlayers-1 then
     pool[#pool+1]=s.id
    end
   end
   if #pool>0 then picked=pool[math.random(1,#pool)] end
  end)
  if not alive then return end
  if picked then
   setToolStatus(tr("srv_switch"))
   local ok=pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId,picked,P) end)
   if not ok then setToolStatus(tr("srv_tpfail")) end
  else
   setToolStatus(tr("srv_none"))
   local ok=pcall(function() TeleportService:Teleport(game.PlaceId,P) end)
   if not ok then setToolStatus(tr("srv_hopfail")) end
  end
  task.wait(5)
  hopping=false
 end)
end
conn(TeleportService.TeleportInitFailed:Connect(function()
 setToolStatus(tr("srv_retry"))
 hopping=false
end))

local function rejoin()
 setToolStatus(tr("rejoining"))
 pcall(function()
  if #Players:GetPlayers()<=1 then
   TeleportService:Teleport(game.PlaceId,P)
  else
   TeleportService:TeleportToPlaceInstance(game.PlaceId,game.JobId,P)
  end
 end)
end

