  while alive do
   local left=fuseLeft()
   if left>0 then
    local h,m,s=math.floor(left/3600),math.floor(left/60)%60,left%60
    local t=(h>0) and string.format("%d:%02d:%02d",h,m,s) or string.format("%02d:%02d",m,s)
    fzl.Text=trf("fz_cd",t)
    fzl.TextColor3=C.acc2
