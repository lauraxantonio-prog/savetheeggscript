local FILE="AntonioHub_v2.json"
local canFile=(type(writefile)=="function" and type(readfile)=="function" and type(isfile)=="function")
local S={
 lang="de",theme=1,accent=1,custom=false,accR=124,accG=92,accB=255,
 font=1,espFont=1,uiScale=100,anim=true,borderAnim=true,menuKey="RightControl",
