local function runSweep(radius,onProg,onDone)
 if sweeping then return false end
 local c=P.Character
 local hrp=c and c:FindFirstChild("HumanoidRootPart")
 if not hrp then return false end
 sweeping=true
 task.spawn(function()
  local center=hrp.Position
  local _,sr=streamingInfo()
  local step=math.max(200,sr*1.3)
  local n=math.floor(radius/step)
  local pts={}
  for ix=-n,n do
   for iz=-n,n do
    local off=Vector3.new(ix*step,0,iz*step)
    if off.Magnitude<=radius+step*0.5 then pts[#pts+1]=center+off end
   end
  end
  table.sort(pts,function(a,b) return (a-center).Magnitude<(b-center).Magnitude end)
  local total=#pts
  for i,pt in ipairs(pts) do
   if not alive or not sweeping then break end
   pcall(function() P:RequestStreamAroundAsync(pt,3) end)
   pcall(updateTargets)
   local cnt=0
   for _ in pairs(cache) do cnt=cnt+1 end
   if onProg then pcall(onProg,i,total,cnt) end
   task.wait(0.1)
  end
  sweeping=false
  local cnt=0
  for _ in pairs(cache) do cnt=cnt+1 end
  if onDone then pcall(onDone,cnt) end
 end)
 return true
end

