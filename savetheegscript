--// ---------------- TELEPORT KERN (v3.9: in Schritten + Position halten) ----------------
HK.tpToken=0
HK.tpUntil=0
HK.moveTo=function(pos)
 local c0=P.Character
 local hrp0=c0 and c0:FindFirstChild("HumanoidRootPart")
 if not hrp0 then return end
 HK.tpToken=HK.tpToken+1
 local my=HK.tpToken
 local from=hrp0.Position
 local dist=(pos-from).Magnitude
 local step=math.max(10,S.tpStep)
 local n=(S.tpSafe and dist>step) and math.ceil(dist/step) or 1
 HK.tpUntil=tick()+n*S.tpDelay+S.tpHold+0.6
 task.spawn(function()
  local function put(p)
   local h=P.Character and P.Character:FindFirstChild("HumanoidRootPart")
   if not h then return false end
   h.CFrame=CFrame.new(p)*h.CFrame.Rotation
   pcall(function() h.AssemblyLinearVelocity=Vector3.zero h.AssemblyAngularVelocity=Vector3.zero end)
   return true
  end
  if n==1 then
   put(pos)
  else
   for i=1,n do
    if not alive or HK.tpToken~=my then return end
    if not put(from:Lerp(pos,i/n)) then return end
    task.wait(S.tpDelay)
   end
  end
  -- Position halten: wenn der Server zurückzieht, wieder hinsetzen
  local t0,fixes=tick(),0
  while alive and HK.tpToken==my and tick()-t0<S.tpHold do
   task.wait(0.05)
   local h=P.Character and P.Character:FindFirstChild("HumanoidRootPart")
   if h and (h.Position-pos).Magnitude>12 and fixes<12 then
    fixes=fixes+1
    put(pos)
   end
  end
 end)
end

