-- Render-Loop: ESP-Anzeige (v3.4: kompakter Text = Name / "123 m  H 7.0"; v4.2: Mutation)
do
 local textT=0
 local rbI -- v4.1: Index des Rainbow-Eis (Regenbogenfarbe im ESP)
 for i,ty in ipairs(TYPES) do if ty.text=="rainbow egg" then rbI=i end end
 local MUTCOL={Color3.fromRGB(255,200,0),Color3.fromRGB(100,230,255)}
 conn(RS.RenderStepped:Connect(function()
  local cam=workspace.CurrentCamera
  if not cam then return end
  local now=tick()
  local vs=cam.ViewportSize
  local c=P.Character
  local hrp=c and c:FindFirstChild("HumanoidRootPart")
  local ref=hrp and hrp.Position or cam.CFrame.Position
  local pulse=math.abs(math.sin(now*3))
  local rainbow=Color3.fromHSV((now*0.5)%1,1,1)
  local origin
  if S.tracerOrigin==2 then origin=Vector2.new(vs.X/2,vs.Y/2)
  elseif S.tracerOrigin==3 then origin=Vector2.new(vs.X/2,0)
  else origin=Vector2.new(vs.X/2,vs.Y) end
  local doText=now>=textT
  if doText then textT=now+0.1 end
  local fnt=espFontEnum()
  for _,m in pairs(marks) do
   local ty=TYPES[m.ti]
   local part=m.part
   if part and part.Parent and ty then
    local d=(part.Position-ref).Magnitude
    local show=S.espOn and (S.maxDist<=0 or d<=S.maxDist)
    m.bb.Enabled=show
    -- Rainbow-Ei: Farbe wechselt durchs Spektrum (abschaltbar in den Einstellungen)
    if rbI and m.ti==rbI then
     if S.rainbowEsp then
      m.rbOn=true
      if m.lb then m.lb.TextColor3=rainbow end
      if m.hl then m.hl.FillColor=rainbow end
      if m.box then m.box.Color3=rainbow end
      if m.line then m.line.Color=rainbow end
     elseif m.rbOn then
      m.rbOn=false
      if m.lb then m.lb.TextColor3=ty.color end
      if m.hl then m.hl.FillColor=ty.color end
      if m.box then m.box.Color3=ty.color end
      if m.line then m.line.Color=ty.color end
     end
    end
    -- v4.2: Mutation faerbt das Ei (Gold / Diamond / Rainbow)
    local mut=m.mut or 0
    if S.mutTag and mut>0 then
     local mc=(mut==3) and rainbow or MUTCOL[mut]
     m.mcOn=true
     if m.lb then m.lb.TextColor3=mc end
     if m.hl then m.hl.FillColor=mc end
     if m.box then m.box.Color3=mc end
     if m.line then m.line.Color=mc end
    elseif m.mcOn then
     m.mcOn=false
     local base=ty.color
     if m.lb then m.lb.TextColor3=base end
     if m.hl then m.hl.FillColor=base end
     if m.box then m.box.Color3=base end
     if m.line then m.line.Color=base end
    end
    if m.hl then
     m.hl.Enabled=show and S.hl and m.allow
     if show then
      m.hl.FillTransparency=math.clamp(S.fill+(S.pulse and 0.3*pulse or 0),0,1)
      m.hl.OutlineTransparency=S.hlOutline and 0 or 1
     end
    end
    if m.box then
     local needBox=(not m.hl) or (not m.allow)
     m.box.Visible=show and S.hl and needBox
     if m.box.Visible then
      m.box.Transparency=math.clamp(0.4+(S.pulse and 0.3*pulse or 0),0,1)
     end
    end
    if show then
     m.lb.TextSize=S.textSize
     m.lb.Font=fnt
     if doText then
      local lines={}
      if S.showName then
       local nm=S.shortNames and (ty.name:gsub(" Egg","")) or ty.name
       if S.mutTag and mut>0 then nm=nm.." ("..HK.MUTN[mut]..")" end
       lines[#lines+1]=nm
      end
      if S.showLuck then lines[#lines+1]="Luck "..ty.luck end
      local info={}
      if S.showDist then info[#info+1]=math.floor(d).." m" end
      if S.showSize then info[#info+1]="H "..string.format("%.1f",m.big) end
      if #info>0 then lines[#lines+1]=table.concat(info,"  ") end
      m.lb.Text=table.concat(lines,"\n")
     end
    end
    if m.line then
     local v,on=cam:WorldToViewportPoint(part.Position)
     local vis=show and on and S.tracers
     m.line.Visible=vis
     if vis then
      m.line.From=origin
      m.line.To=Vector2.new(v.X,v.Y)
      m.line.Thickness=S.tracerW
     end
    end
   else
    m.bb.Enabled=false
    if m.hl then m.hl.Enabled=false end
    if m.box then m.box.Visible=false end
    if m.line then m.line.Visible=false end
   end
  end
 end))
end

