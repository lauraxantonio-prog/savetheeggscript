 local rbLast,rbHrp,rbHits,rbWarn=nil,nil,{},0
 conn(RS.Heartbeat:Connect(function(dt)
  local h=hum()
  local hr=root()
  -- Geschwindigkeit messen (Live-Anzeige)
  if hr then
   local now=tick()
   if lastPos and now>lastT then speedNow=(hr.Position-lastPos).Magnitude/(now-lastT) end
   lastPos=hr.Position lastT=now
  end
  -- Rubberband-Schutz: erkennt, wenn der Server dich zurückzieht, und setzt dich wieder hin
  do
   local active=S.rbGuard and (PL.fly or PL.speed or PL.jump or PL.noclip)
   if not (hr and active) or tick()<(HK.tpUntil or 0) then
    rbLast=nil
   else
    if hr~=rbHrp then rbHrp=hr rbLast=nil end
    local p=hr.Position
    if rbLast then
     local vmax=math.max(50,PL.fly and S.plFlySpeed or 0,PL.speed and S.plSpeedVal*S.plSprintMul or 0)
     local lim=math.max(35,vmax*dt*3+10)
     if (p-rbLast).Magnitude>lim then
      hr.CFrame=CFrame.new(rbLast)*hr.CFrame.Rotation
      pcall(function() hr.AssemblyLinearVelocity=Vector3.zero end)
      local now=tick()
      rbHits[#rbHits+1]=now
      for i=#rbHits,1,-1 do if now-rbHits[i]>4 then table.remove(rbHits,i) end end
      if #rbHits>=3 then
       rbHits={}
       S.plFlySpeed=math.max(20,math.floor(S.plFlySpeed*0.75))
       S.plSpeedVal=math.max(16,math.floor(S.plSpeedVal*0.75))
       if flyS then flyS.set(S.plFlySpeed,false) end
       if spdS then spdS.set(S.plSpeedVal,false) end
       if now-rbWarn>5 then rbWarn=now notify(tr("rb_reduced"),C.bad,true) end
      end
     else
      rbLast=p
     end
    else
     rbLast=p
    end
   end
  end
  -- Anti-Void: merkt sich die letzte sichere Stelle am Boden
  if S.plAntiVoid and hr and h and h.Health>0 and not PL.fly then
   if h.FloorMaterial~=Enum.Material.Air then
    lastSafe=hr.Position+Vector3.new(0,3,0)
   elseif lastSafe then
    local fh=-500
    pcall(function() fh=workspace.FallenPartsDestroyHeight end)
    if fh<-1e4 then fh=-1e4 end
    if hr.Position.Y<fh+120 then
     hr.CFrame=CFrame.new(lastSafe)
     pcall(function() hr.AssemblyLinearVelocity=Vector3.zero end)
    end
   end
  end
  if PL.grav and origGrav~=nil then workspace.Gravity=origGrav*S.plGravVal/100 end
  local focused=UIS:GetFocusedTextBox()~=nil
  if h then
   local shift=S.plSprint and not focused and UIS:IsKeyDown(Enum.KeyCode.LeftShift)
   local sv=S.plSpeedVal*(shift and S.plSprintMul or 1)
   if PL.speed then
    if S.plSpeedMode==1 then
     h.WalkSpeed=sv
    else
     local base=origSpeed or 16
     if h.WalkSpeed~=base then h.WalkSpeed=base end
     if hr and not PL.fly and h.MoveDirection.Magnitude>0.05 then
      hr.CFrame=hr.CFrame+h.MoveDirection*math.max(0,sv-base)*dt
     end
    end
   end
   if PL.jump then
    pcall(function() h.UseJumpPower=true h.JumpPower=S.plJumpVal end)
   end
   if PL.bhop and not focused and UIS:IsKeyDown(Enum.KeyCode.Space) and h.FloorMaterial~=Enum.Material.Air then
    h.Jump=true
   end
   -- Auto-Run: läuft vorwärts, solange keine WASD-Taste gedrückt ist
   if PL.run and not PL.fly and not focused then
    local manual=UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.D)
    if not manual then pcall(function() h:Move(Vector3.new(0,0,-1),true) end) end
   end
  end
  -- Fliegen: sanfte Beschleunigung, Tastatur und Touch (Stick + Sprung-Button)
  if PL.fly and hr and h then
   local cam=workspace.CurrentCamera
   if cam then
    local cf=cam.CFrame
    local dir=Vector3.zero
    local md=h.MoveDirection
    if md.Magnitude>0.05 then
     local flat=Vector3.new(cf.LookVector.X,0,cf.LookVector.Z)
     flat=(flat.Magnitude>0.01) and flat.Unit or Vector3.new(0,0,-1)
     local rt=Vector3.new(-flat.Z,0,flat.X)
     dir=cf.LookVector*md:Dot(flat)+cf.RightVector*md:Dot(rt)
    end
    if not focused then
     if UIS:IsKeyDown(Enum.KeyCode.Space) or h.Jump then dir=dir+Vector3.new(0,1,0) end
     if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir=dir-Vector3.new(0,1,0) end
    end
    if dir.Magnitude>1 then dir=dir.Unit end
    local target=dir*S.plFlySpeed
    PL.vel=PL.vel:Lerp(target,math.clamp(dt*10,0,1))
    hr.AssemblyLinearVelocity=PL.vel
   end
  end
 end))
