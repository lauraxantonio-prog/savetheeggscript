 local function L(de,en) return (S.lang=="en") and en or de end
 local function cut(s,n) if #s>n then return s:sub(1,n-3).."..." end return s end
 local function colorInt(c) return math.floor(c.R*255+0.5)*65536+math.floor(c.G*255+0.5)*256+math.floor(c.B*255+0.5) end
 local function joinLink() return "https://www.roblox.com/games/start?placeId="..game.PlaceId.."&gameInstanceId="..game.JobId end
 local MUT_ICON={[0]="⚪","🟡","💎","🌈"}
 local function mutName(m)
  m=m or 0
  if m==0 then return "Normal" end
  if m==1 then return "Gold" end
  if m==2 then return L("Diamant","Diamond") end
  return "Rainbow"
 end

 local WATCH,isWatch={}, {}
 for _,key in ipairs({"halloween egg","skeleton egg","bone king egg","bone demon egg","thunder egg","samurai egg","demon egg"}) do
  for i,ty in ipairs(TYPES) do
   if ty.text==key then WATCH[#WATCH+1]=i isWatch[i]=true end
  end
 end

 --// HTTP-Kern (HK.post bleibt fuer den Notifier erhalten)
 local function getReq() return (syn and syn.request) or request or http_request or (http and http.request) end
 HK.valid=function(url)
  if type(url)~="string" or url:sub(1,8)~="https://" then return false end
  return (url:find("discord.com/api/webhooks/",1,true) or url:find("discordapp.com/api/webhooks/",1,true)) and true or false
 end
 HK.call=function(method,url,tbl,cb)
  local req=getReq()
  if not req then if cb then cb(false,"na") end return end
  local body
  if tbl~=nil then
   local ok0,b=pcall(function() return HttpService:JSONEncode(tbl) end)
   if not ok0 then if cb then cb(false,"fail") end return end
   body=b
  end
  task.spawn(function()
   local ok,r=pcall(req,{Url=url,Method=method,Headers={["Content-Type"]="application/json"},Body=body})
   local isT=ok and type(r)=="table"
   local code=isT and r.StatusCode or nil
   local good=isT and (code==nil or (type(code)=="number" and code>=200 and code<300)) or false
   local why="ok"
   if not good then why=(code==404 and "gone") or (code==429 and "rate") or "fail" end
   if cb then cb(good,why,isT and r.Body or nil) end
  end)
 end
 HK.post=function(tbl,cb)
  if not HK.valid(S.nfHook) then if cb then cb(false,"bad") end return end
  HK.call("POST",S.nfHook,tbl,cb)
 end
 local function postWait(tbl)
  local done,good,why=false,false,"fail"
  HK.post(tbl,function(g,w) good=g why=w done=true end)
  local t0=tick()
  while not done and tick()-t0<15 do task.wait(0.1) end
  return good,why
 end

 --// Embed fuer eine Eiersorte
 local function buildEmbed(ti,newN)
  local ty=TYPES[ti]
  local list,mc={}, {[0]=0,0,0,0}
  for _,e in pairs(lastTargets) do
   if e.ti==ti then
    list[#list+1]=e
    local m=e.mut or 0
    mc[m]=(mc[m] or 0)+1
   end
  end
  table.sort(list,function(a,b)
   if (a.mut or 0)~=(b.mut or 0) then return (a.mut or 0)>(b.mut or 0) end
   return (a.big or 0)>(b.big or 0)
  end)
  local n=#list
  local mparts={}
  for m=0,3 do
   if (mc[m] or 0)>0 then mparts[#mparts+1]=MUT_ICON[m].." "..mutName(m)..": **"..mc[m].."**" end
  end
  local ls={}
  for i=1,math.min(n,5) do
   local e=list[i]
   ls[#ls+1]="`#"..i.."` "..MUT_ICON[e.mut or 0].." **"..mutName(e.mut).."**  📏 "..string.format("%.1f",e.big or 0).." studs"..(e.live and "" or " 👻")
  end
  if n>5 then ls[#ls+1]="… +"..(n-5).." "..L("weitere","more") end
  return {
   title="🚨 "..ty.name.." "..L("im Server!","in server!"),
   url=joinLink(),
   description="🍀 Luck **"..ty.luck.."**"..((newN or 0)>0 and ("  •  🆕 +"..newN) or ""),
   color=colorInt(ty.color),
   fields={
    {name="📦 "..L("Anzahl im Server","Count in server"),value="**×"..n.."**",inline=true},
    {name="✨ Mutation",value=#mparts>0 and cut(table.concat(mparts,"\n"),1000) or "–",inline=true},
    {name="📏 "..L("Größe","Size"),value=#ls>0 and cut(table.concat(ls,"\n"),1000) or "–",inline=false},
    {name="🔗 "..L("Spiel-Link","Game link"),value="**[▶ "..L("Server beitreten","Join server").."]("..joinLink()..")**\nJobId `"..game.JobId.."`",inline=false},
   },
   footer={text="Antonio Hub v5.0  •  discord.gg/saveegg"},
   timestamp=os.date("!%Y-%m-%dT%H:%M:%SZ"),
  }
 end

 local function sendFound(order,newCount)
  local embeds={}
  for _,ti in ipairs(order) do
   embeds[#embeds+1]=buildEmbed(ti,newCount[ti])
   if #embeds>=10 then break end
  end
  return postWait({username="Antonio Hub",content="@everyone 🚨",embeds=embeds,allowed_mentions={parse={"everyone"}}})
 end

