  end
  box=raw("BoxHandleAdornment",{Adornee=part,AlwaysOnTop=true,ZIndex=10,Size=boxSize,Color3=ty.color,Transparency=0.5,Visible=false},gui)
  bb=raw("BillboardGui",{Adornee=part,AlwaysOnTop=true,Size=UDim2.fromOffset(260,110),StudsOffset=Vector3.new(0,4,0),MaxDistance=math.huge,
   DistanceLowerLimit=0,LightInfluence=0,ResetOnSpawn=false},gui)
