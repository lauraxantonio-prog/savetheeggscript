 -- Hauptschleife: FPS-Statistik, Auto-Boost, Auto-Speicherbereinigung, Live-Anzeige
 task.spawn(function()
  local hist={}
  local lowCnt,autoDone=0,false
  local lastGc=tick()
  while alive do
   local f=env.__ANTONIO_FPS or 0
   if f>0 then
    hist[#hist+1]=f
    if #hist>60 then table.remove(hist,1) end
   end
   -- Auto-Boost: 6 Sekunden lang unter der Schwelle -> Boost-Preset
   if PF.auto and not autoDone and f>0 and f<S.pAutoFps then lowCnt=lowCnt+1 else lowCnt=0 end
   if not PF.auto then autoDone=false end
   if lowCnt>=12 then
    autoDone=true
    lowCnt=0
    applyList(BOOST)
    notify(trf("autob_msg",f),C.acc,true)
   end
   if S.pGc and tick()-lastGc>=S.pGcInt then
    lastGc=tick()
    doGc(false)
   end
   if cur=="perf" then
    local ping,ram="-","-"
    pcall(function() ping=math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()).." ms" end)
    pcall(function() ram=tostring(math.floor(Stats:GetTotalMemoryUsageMb())) end)
    live.Text=trf("f_live_t",tostring(f),ping,ram)
    if #hist>0 then
     local sum,mn,mx=0,math.huge,0
     for _,v in ipairs(hist) do
      sum=sum+v
      if v<mn then mn=v end
      if v>mx then mx=v end
     end
     liveStats.Text=trf("f_stats_t",math.floor(sum/#hist+0.5),mn,mx)
    end
   end
   task.wait(0.5)
  end
 end)

