 local function drawPlayer(c)
  local cx=X.c
  local cam,now,doText=cx.cam,cx.now,cx.doText
  local pl,ch,hrp,hum,d,focus=c.pl,c.ch,c.hrp,c.hum,c.d,c.focus
  local o=objs[pl]
  if not o then o=makeObj() objs[pl]=o end
  o.hidden=false
  if cx.rp then
   local okr,hitr=pcall(function() return workspace:Raycast(cx.camPos,hrp.Position-cx.camPos,cx.rp) end)
   X.vis[pl]=(okr and hitr==nil)
  end
  local hpPct=(hum.MaxHealth>0) and math.clamp(hum.Health/hum.MaxHealth,0,1) or 0
  local col=colorFor(pl,hum,now,X.vis[pl],focus)
  if S.peLow and not focus and hpPct*100<S.peLowPct then
   col=Color3.fromRGB(255,110+math.floor(110*math.abs(math.sin(now*8))),0)
  end
  if o.bb.Adornee~=hrp then o.bb.Adornee=hrp end
  if o.box.Adornee~=hrp then o.box.Adornee=hrp end
  local hit=S.hbOn and hbOrig[hrp]~=nil
  local realY=(hbOrig[hrp] and hbOrig[hrp].s.Y or hrp.Size.Y)
  local off=(S.peTagPos==2) and -(realY/2+4.6) or (realY/2+2.6)
  o.bb.StudsOffset=Vector3.new(0,off,0)
  -- 3D-Box (waechst mit der Hitbox mit)
  local boxOn=(S.peBox and S.peBoxStyle==1) or (S.hbEsp and hit)
  if o.box.Visible~=boxOn then o.box.Visible=boxOn end
  if boxOn then
   o.box.Color3=col
   local want=hit and Vector3.new(S.hbSize,S.hbSize,S.hbSize) or BOXN
   if o.box.Size~=want then o.box.Size=want end
   o.box.Transparency=hit and 0.8 or 0.65
  end
  -- Chams
  if S.peChams then
   if not o.hl then
    o.hl=raw("Highlight",{FillColor=col,OutlineColor=Color3.new(1,1,1),DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Enabled=false},gui)
   end
   if o.hl.Adornee~=ch then o.hl.Adornee=ch end
   o.hl.FillColor=col
   o.hl.OutlineColor=col:Lerp(Color3.new(1,1,1),0.5)
   o.hl.FillTransparency=S.peChamsT
   cx.chams[#cx.chams+1]={o=o,d=d}
  elseif o.hl and o.hl.Enabled then
   o.hl.Enabled=false
  end
  -- Nametag
  local use2D=hasDraw and S.peBox and S.peBoxStyle>=2
  local showTag=S.peName or S.peTool or S.peDist or S.peHp or S.peTeamTag or S.peStats or S.peVel
  o.bb.Enabled=showTag
  if showTag then
   o.lb.TextColor3=col
   o.lb.Font=cx.fnt
   o.lb.TextSize=S.peScale and math.floor(math.clamp(S.peText*(1.25-d/800),9,S.peText+4)) or S.peText
   if doText then
    local lines={}
    if S.peName then
     local nm=pl.DisplayName
     if S.peNameMode==2 then nm=pl.Name elseif S.peNameMode==3 then nm=pl.DisplayName.." (@"..pl.Name..")" end
     lines[#lines+1]=(focus and ">> " or "")..nm
    end
    if S.peTeamTag and pl.Team then lines[#lines+1]="{"..pl.Team.Name.."}" end
    if S.peTool then
     local tl=ch:FindFirstChildOfClass("Tool")
     if tl then lines[#lines+1]="["..tl.Name.."]" end
    end
    if S.peStats then
     local st=statsText(pl)
     if st then lines[#lines+1]=st end
    end
    local info={}
    if S.peDist then info[#info+1]=math.floor(d).." m" end
    if S.peHp then info[#info+1]=math.floor(hum.Health).." HP" end
    if S.peVel then info[#info+1]=math.floor(hrp.AssemblyLinearVelocity.Magnitude).." s/s" end
    if #info>0 then lines[#lines+1]=table.concat(info,"  ") end
    o.lb.Text=table.concat(lines,"\n")
   end
   local showBar=S.peHp and not use2D
   o.barBg.Visible=showBar
   if showBar then
    o.bar.Size=UDim2.fromScale(hpPct,1)
    o.bar.BackgroundColor3=REDC:Lerp(GREEN,hpPct)
   end
  end
  -- Drawing-Features
  local v,on=cam:WorldToViewportPoint(hrp.Position)
  if S.peTracer then
   local l=getD(o,"line","Line")
   if l then
    pcall(function()
     l.Visible=on
     if on then
      l.Color=col
      l.Thickness=S.peTW+(focus and 1 or 0)
      l.From=cx.origin
      l.To=Vector2.new(v.X,v.Y)
     end
    end)
   end
  else
   hideD(o.line)
  end
  if S.peSkel then skelDraw(o,ch,cam,col) else hideList(o.skel) end
  if use2D then draw2D(o,hrp,cam,col,hpPct) else hideList(o.bx) hideList(o.hbl) end
  if S.peLook then
   local l=getD(o,"look","Line")
   if l then
    pcall(function()
     local head=ch:FindFirstChild("Head")
     local shown=false
     if head then
      local p1,on1=cam:WorldToViewportPoint(head.Position)
      local p2,on2=cam:WorldToViewportPoint(head.Position+head.CFrame.LookVector*10)
      if on1 and on2 then
       l.From=Vector2.new(p1.X,p1.Y)
       l.To=Vector2.new(p2.X,p2.Y)
       l.Color=col
       l.Thickness=2
       shown=true
      end
     end
     l.Visible=shown
    end)
   end
  else
   hideD(o.look)
  end
  if S.peHead then
   local circ=getD(o,"circ","Circle")
   if circ then
    pcall(function()
     local head=ch:FindFirstChild("Head")
     if head then
      local p1,o1=cam:WorldToViewportPoint(head.Position)
      local p2=cam:WorldToViewportPoint(head.Position+cam.CFrame.UpVector*0.9)
      if o1 then
       local a,b=Vector2.new(p1.X,p1.Y),Vector2.new(p2.X,p2.Y)
       circ.Position=a
       circ.Radius=math.max(3,(a-b).Magnitude)
       circ.Color=col
       circ.Thickness=1.5
       circ.NumSides=20
       circ.Filled=false
       circ.Visible=true
      else
       circ.Visible=false
      end
     else
      circ.Visible=false
     end
    end)
   end
  else
   hideD(o.circ)
  end
  if S.peArrow and not on then
   local ar=getLines(o,"arrow",3)
   if #ar==3 then
    pcall(function()
     local rel=cam.CFrame:PointToObjectSpace(hrp.Position)
     local dir=Vector2.new(rel.X,rel.Z)
     if dir.Magnitude<0.001 then dir=Vector2.new(0,-1) end
     dir=dir.Unit
     local rad=math.min(cx.vs.X,cx.vs.Y)*0.42
     local pc=cx.scr+dir*rad
     local perp=Vector2.new(-dir.Y,dir.X)
     local tip=pc+dir*14
     local bl=pc-dir*8+perp*10
     local br=pc-dir*8-perp*10
     ar[1].From=tip ar[1].To=bl
     ar[2].From=tip ar[2].To=br
     ar[3].From=bl ar[3].To=br
     for _,l in ipairs(ar) do l.Color=col l.Thickness=2 l.Visible=true end
    end)
   end
  else
   hideList(o.arrow)
  end
 end

