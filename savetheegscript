  round(listBox,10) stroke(listBox,C.border,0.3)
  new("UIPadding",{PaddingTop=UDim.new(0,6),PaddingBottom=UDim.new(0,6),PaddingLeft=UDim.new(0,6),PaddingRight=UDim.new(0,6)},listBox)
  new("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},listBox)
  local emptyL=new("TextLabel",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,22),TextColor3=C.sub,Font=Enum.Font.Gotham,TextSize=12,
   TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=0},listBox)
  reg(emptyL,"cfg_empty")
  local rowsC={}
  local function refreshList()
   for _,r in ipairs(rowsC) do pcall(function() r:Destroy() end) end
   rowsC={}
