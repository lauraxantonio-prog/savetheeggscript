    local col
    if want and S.hbPaint then col=colorFor(pl,hum,now,X.vis[pl],X.focus==pl) end
    local sz=Vector3.new(S.hbSize,S.hbSize,S.hbSize)
    if hrp then
     if want then hbApply(hrp,sz,S.hbTrans,col) else hbRestore(hrp) end
    end
    if head and head:IsA("BasePart") then
     if want and S.hbHead then
      local s=math.max(2,S.hbSize*0.7)
      hbApply(head,Vector3.new(s,s,s),S.hbTrans,col)
     else
      hbRestore(head)
     end
    end
    if ch then
     for _,n in ipairs(TORSO) do
      local tp=ch:FindFirstChild(n)
      if tp and tp:IsA("BasePart") then
       if want and S.hbBody then
        local s=math.max(2,S.hbSize*0.8)
        hbApply(tp,Vector3.new(s,s,s),S.hbTrans,col)
       else
        hbRestore(tp)
       end
      end
     end
    end
   end
  end
  if not S.hbOn and next(hbOrig) then hbRestoreAll() end
 end))

