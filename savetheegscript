local C={good=rgb(80,220,140),bad=rgb(235,70,95)}
local BKEYS={"bg","side","item","hover","off","border","txt","sub","acc","acc2"}
local function applyColors()
 local th=THEMES[S.theme] or THEMES[1]
 for _,k in ipairs({"bg","side","item","hover","off","border","txt","sub"}) do C[k]=th[k] end
 if S.custom then
  C.acc=Color3.fromRGB(S.accR,S.accG,S.accB)
  local h,s,v=C.acc:ToHSV()
  C.acc2=Color3.fromHSV((h-0.12)%1,math.clamp(s*0.9,0,1),math.clamp(v+0.1,0,1))
 else
  local a=ACCENTS[S.accent] or ACCENTS[1]
  C.acc=a.c1 C.acc2=a.c2
 end
end
applyColors()

local binds,fontObjs,themeFns={}, {}, {}
local FONTW={[Enum.Font.Gotham]="r",[Enum.Font.GothamMedium]="m",[Enum.Font.GothamBold]="b",[Enum.Font.GothamBlack]="k"}
local function fontOf(w) return FAMILIES[S.font].E[w] end
local function espFontEnum() return FAMILIES[S.espFont].E.b end

local MAXSIZE=30
local WIN_W,WIN_H=640,420

local function new(cls,props,parent,nobind)
 local o=Instance.new(cls)
 local fw
 if props.Font then
  fw=FONTW[props.Font]
  if fw then props.Font=fontOf(fw) end
 end
 for k,v in pairs(props) do
  o[k]=v
  if not nobind and typeof(v)=="Color3" then
   for _,key in ipairs(BKEYS) do
    if C[key]==v then binds[#binds+1]={o,k,key} break end
   end
  end
 end
 if fw then fontObjs[#fontObjs+1]={o,fw} end
 o.Parent=parent
 return o
end
local function raw(cls,props,parent)
 local o=Instance.new(cls)
 for k,v in pairs(props) do o[k]=v end
 o.Parent=parent
 return o
end
local function round(o,r) return new("UICorner",{CornerRadius=UDim.new(0,r)},o) end
local function stroke(o,col,t) return new("UIStroke",{Color=col,Thickness=1,Transparency=t or 0.3,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},o) end
local function tw(o,props,t,style,dir)
 local tween=TS:Create(o,TweenInfo.new(S.anim and (t or 0.2) or 0,style or Enum.EasingStyle.Quad,dir or Enum.EasingDirection.Out),props)
 tween:Play()
