  end)
  if not ghostPart then return end
  part=ghostPart
 end
 -- Boxgroesse: echte Groesse des Eis (bei Geistern die gemerkte Groesse)
 local boxSize=Vector3.new(2,2,2)
 if obj then
  local sz=sizeOf(obj)
  if sz then boxSize=sz+Vector3.new(0.2,0.2,0.2) end
 elseif e.big and e.big>0 then
  local b=math.clamp(e.big,1,MAXSIZE)+0.2
