    fzWasRunning=true
   else
    fzl.Text=tr("fz_ready")
    fzl.TextColor3=C.good
    fzs.Color=C.good
    if fzWasRunning then
     fzWasRunning=false
     if S.fuseEnd~=0 then S.fuseEnd=0 save() end
     if S.fuseOn then notify(tr("fz_done"),C.good) end
    end
