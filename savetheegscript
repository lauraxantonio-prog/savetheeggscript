   if S.tpOnlyOn and not ty.on then okF=false end
   if S.tpOnlyMut and not HK.isMut(e) then okF=false end
   if S.tpOnlyLive and not e.live then okF=false end
   if okF and (q=="" or string.find(string.lower(ty.name),q,1,true)) then
    local mn=(e.mut or 0)>0 and (" ("..HK.MUTN[e.mut]..")") or ""
    local s=string.format("Luck %s  •  %s",ty.luck,coordText(e.pos))
    if not e.live then s=s.."  •  "..tr("ghost_tag") end
    items[#items+1]={key=k,ti=e.ti,name=ty.name..mn,sub=s,color=ty.color,pos=e.pos,d=rp and (e.pos-rp).Magnitude or math.huge,
     act=function()
      local ee=lastTargets[k]
      if ee then
       if tpTo(ee) then setStatus(trf("tp_ok",TYPES[ee.ti].name)) end
      else
       notify(tr("tp_gone"),C.bad,true)
      end
     end}
   end
  end
  if S.tpSort==2 then
   table.sort(items,function(a,b)
    if a.d~=b.d then return a.d<b.d end
    return a.key<b.key
   end)
  else
   table.sort(items,function(a,b)
    if a.ti~=b.ti then return a.ti>b.ti end
    if a.d~=b.d then return a.d<b.d end
    return a.key<b.key
   end)
  end
  return items,all
 end

 local function buildPlayers(q,rp)
  local items,all={}, 0
  for _,pl in ipairs(Players:GetPlayers()) do
   if pl~=P then
    local ch=pl.Character
    local ph=ch and ch:FindFirstChild("HumanoidRootPart")
    if ph then
     all=all+1
     if q=="" or string.find(string.lower(pl.Name),q,1,true) or string.find(string.lower(pl.DisplayName),q,1,true) then
      local hum=ch:FindFirstChildOfClass("Humanoid")
      local s="@"..pl.Name
      if hum then s=s.."  •  "..math.floor(hum.Health).." HP" end
      if pl.Team then s=s.."  •  "..pl.Team.Name end
      items[#items+1]={name=pl.DisplayName,sub=s,color=pl.Team and pl.TeamColor.Color or C.acc,pos=ph.Position,
       d=rp and (ph.Position-rp).Magnitude or math.huge,
       act=function()
        local h=pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
        if h then
         HK.moveTo(h.Position+Vector3.new(0,S.tpHeight,0))
         setStatus(trf("pl_tp_ok",pl.DisplayName))
         notify(trf("pl_tp_ok",pl.DisplayName),C.acc,true)
        else
         notify(tr("pl_gone"),C.bad,true)
        end
       end}
     end
    end
   end
  end
  table.sort(items,function(a,b) return a.d<b.d end)
  return items,all
 end

 local function buildPlaces(q,rp)
  local items={}
  local function add(name,pos,color,sub,act)
   if q=="" or string.find(string.lower(name),q,1,true) then
    items[#items+1]={name=name,sub=sub or coordText(pos),color=color,pos=pos,d=rp and (pos-rp).Magnitude or math.huge,act=act}
   end
  end
  local h=getHome()
  if h then
   local hp=Vector3.new(h.x,h.y,h.z)
   add(tr("tpl_home"),hp,GOLDC,nil,function() goHome() end)
  end
  if tick()-spawnT>5 then
   spawnT=tick()
   spawnCache=workspace:FindFirstChildWhichIsA("SpawnLocation",true)
  end
  if spawnCache and spawnCache.Parent then
   local sp=spawnCache.Position
   add(tr("tpl_spawn"),sp,C.acc2,nil,function() goPlace(sp+Vector3.new(0,2,0),tr("tpl_spawn")) end)
  end
  local saves=S.homeSaves[homeKey]
  if type(saves)=="table" then
   for _,s in ipairs(saves) do
    local p=Vector3.new(s.x,s.y,s.z)
    add(trf("tpl_save",s.n),p,GOLDC,nil,function() goPlace(p,s.n) end)
   end
  end
  local wps=S.wps[homeKey]
