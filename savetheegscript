local langFns,textObjs={}, {}
local function tr(k) local t=D[S.lang] return (t and t[k]) or D.de[k] or k end
local function trf(k,...) local ok,r=pcall(string.format,tr(k),...) if ok then return r end return tr(k) end
local function onLang(fn) langFns[#langFns+1]=fn pcall(fn) end
local function reg(o,key,prop)
 prop=prop or "Text"
 textObjs[#textObjs+1]={o,key,prop}
 o[prop]=tr(key)
 return o
end

